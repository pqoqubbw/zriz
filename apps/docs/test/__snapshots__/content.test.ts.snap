    "zoom/steps.tsx",
    ""use client";

import { useZoom } from "@zriz/react";
import * as Cropper from "@zriz/react/cropper";

export const ZoomSteps = () => {
  const zoom = useZoom();
  return (
    <>
      <Cropper.ZoomStep
        factor={0.8}
        aria-label="Zoom out"
        disabled={zoom.value <= zoom.min}
      >
        −
      </Cropper.ZoomStep>
      <Cropper.ZoomStep
        factor={1.25}
        aria-label="Zoom in"
        disabled={zoom.value >= zoom.max}
      >
        +
      </Cropper.ZoomStep>
    </>
  );
};",
    "<span class=s>"use client"</span><span class=p>;</span>

<span class=k>import </span><span class=p>{</span> useZoom <span class=p>} </span><span class=k>from </span><span class=s>"@zriz/react"</span><span class=p>;</span>
<span class=k>import </span><span class=p>* </span><span class=k>as</span> Cropper <span class=k>from </span><span class=s>"@zriz/react/cropper"</span><span class=p>;</span>

<span class=k>export const </span><span class=t>ZoomSteps </span><span class=p>= () =&gt; {</span>
  <span class=k>const</span> zoom <span class=p>= </span><span class=t>useZoom</span><span class=p>();</span>
  <span class=k>return </span><span class=p>(</span>
    <span class=p>&lt;&gt;</span>
      <span class=p>&lt;</span><span class=t>Cropper.ZoomStep</span>
        <span class=a>factor</span><span class=p>={</span><span class=n>0.8</span><span class=p>}</span>
        <span class=a>aria-label</span><span class=p>="</span><span class=s>Zoom out</span><span class=p>"</span>
        <span class=a>disabled</span><span class=p>={</span>zoom<span class=p>.</span>value <span class=p>&lt;=</span> zoom<span class=p>.</span>min<span class=p>}</span>
      <span class=p>&gt;</span>
        −
      <span class=p>&lt;/</span><span class=t>Cropper.ZoomStep</span><span class=p>&gt;</span>
      <span class=p>&lt;</span><span class=t>Cropper.ZoomStep</span>
        <span class=a>factor</span><span class=p>={</span><span class=n>1.25</span><span class=p>}</span>
        <span class=a>aria-label</span><span class=p>="</span><span class=s>Zoom in</span><span class=p>"</span>
        <span class=a>disabled</span><span class=p>={</span>zoom<span class=p>.</span>value <span class=p>&gt;=</span> zoom<span class=p>.</span>max<span class=p>}</span>
      <span class=p>&gt;</span>
        +
      <span class=p>&lt;/</span><span class=t>Cropper.ZoomStep</span><span class=p>&gt;</span>
    <span class=p>&lt;/&gt;</span>
  <span class=p>);</span>
<span class=p>};</span>",
  ],
  [
    "zoom",
    "zoom/slider.tsx",
    ""use client";

import { useZoom } from "@zriz/react";

export const ZoomSlider = () => {
  const zoom = useZoom();
  return (
    <input
      type="range"
      aria-label="Zoom"
      min={zoom.min}
      max={zoom.max}
      step={0.01}
      value={zoom.value}
      onChange={(e) =>
        zoom.onValueChange(e.target.valueAsNumber)
      }
      onPointerUp={zoom.onValueCommitted}
      onPointerCancel={zoom.onValueCommitted}
      onKeyUp={zoom.onValueCommitted}
    />
  );
};",
    "<span class=s>"use client"</span><span class=p>;</span>

<span class=k>import </span><span class=p>{</span> useZoom <span class=p>} </span><span class=k>from </span><span class=s>"@zriz/react"</span><span class=p>;</span>

<span class=k>export const </span><span class=t>ZoomSlider </span><span class=p>= () =&gt; {</span>
  <span class=k>const</span> zoom <span class=p>= </span><span class=t>useZoom</span><span class=p>();</span>
  <span class=k>return </span><span class=p>(</span>
    <span class=p>&lt;</span><span class=t>input</span>
      <span class=a>type</span><span class=p>="</span><span class=s>range</span><span class=p>"</span>
      <span class=a>aria-label</span><span class=p>="</span><span class=s>Zoom</span><span class=p>"</span>
      <span class=a>min</span><span class=p>={</span>zoom<span class=p>.</span>min<span class=p>}</span>
      <span class=a>max</span><span class=p>={</span>zoom<span class=p>.</span>max<span class=p>}</span>
      <span class=a>step</span><span class=p>={</span><span class=n>0.01</span><span class=p>}</span>
      <span class=a>value</span><span class=p>={</span>zoom<span class=p>.</span>value<span class=p>}</span>
      <span class=a>onChange</span><span class=p>={(</span>e<span class=p>) =&gt;</span>
        zoom<span class=p>.</span><span class=t>onValueChange</span><span class=p>(</span>e<span class=p>.</span>target<span class=p>.</span>valueAsNumber<span class=p>)</span>
