          <span class=k>if </span><span class=p>(!</span>file <span class=p>|| !</span>cropper<span class=p>.</span>current<span class=p>) </span><span class=k>return</span><span class=p>;</span>
          last<span class=p>.</span>current<span class=p>?.</span><span class=t>abort</span><span class=p>();</span>
