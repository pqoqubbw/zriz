  handle<span class=p>.</span><span class=t>setAttribute</span><span class=p>(</span><span class=s>"aria-hidden"</span><span class=p>, </span><span class=s>"true"</span><span class=p>);</span>
  <span class=t>byId</span><span class=p>(</span><span class=s>"area"</span><span class=p>).</span><span class=t>append</span><span class=p>(</span>handle<span class=p>);</span>
  cleanups<span class=p>.</span><span class=t>push</span><span class=p>(</span><span class=t>bindHandle</span><span class=p>(</span>cropper<span class=p>,</span> handle<span class=p>,</span> corner<span class=p>));</span>
<span class=p>}</span>

