      <span class=p>&lt;</span><span class=t>button </span><span class=a>type</span><span class=p>="</span><span class=s>button</span><span class=p>" </span><span class=a>disabled</span><span class=p>={!</span>ready<span class=p>} </span><span class=a>onClick</span><span class=p>={</span>upload<span class=p>}&gt;</span>
        upload
      <span class=p>&lt;/</span><span class=t>button</span><span class=p>&gt;</span>
