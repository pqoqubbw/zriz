    "cropper",
    "cropper/gesture.ts",
    "import { createCropper } from "@zriz/core";

const cropper = createCropper({
  image: { width: 4032, height: 3024 },
});
const owner = {};

export const bind = (input: HTMLInputElement) => {
  input.addEventListener("pointerdown", (event) => {
    cropper.begin("dial", event, owner);
  });

  input.addEventListener("input", () => {
    cropper.setRotation(input.valueAsNumber);
  });

  const end = (event: PointerEvent) => {
    cropper.end(event, owner);
  };

  input.addEventListener("pointerup", end);
  input.addEventListener("pointercancel", end);
};",
    "<span class=k>import </span><span class=p>{</span> createCropper <span class=p>} </span><span class=k>from </span><span class=s>"@zriz/core"</span><span class=p>;</span>

<span class=k>const</span> cropper <span class=p>= </span><span class=t>createCropper</span><span class=p>({</span>
  image<span class=p>: {</span> width<span class=p>: </span><span class=n>4032</span><span class=p>,</span> height<span class=p>: </span><span class=n>3024 </span><span class=p>},</span>
<span class=p>});</span>
<span class=k>const</span> owner <span class=p>= {};</span>

<span class=k>export const </span><span class=t>bind </span><span class=p>= (</span>input<span class=p>:</span> HTMLInputElement<span class=p>) =&gt; {</span>
  input<span class=p>.</span><span class=t>addEventListener</span><span class=p>(</span><span class=s>"pointerdown"</span><span class=p>, (</span>event<span class=p>) =&gt; {</span>
    cropper<span class=p>.</span><span class=t>begin</span><span class=p>(</span><span class=s>"dial"</span><span class=p>,</span> event<span class=p>,</span> owner<span class=p>);</span>
