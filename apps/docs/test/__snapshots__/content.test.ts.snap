  <span class=t>bindViewport</span><span class=p>(</span>cropper<span class=p>, </span><span class=t>byId</span><span class=p>(</span><span class=s>"viewport"</span><span class=p>)),</span>
  <span class=t>bindPhoto</span><span class=p>(</span>cropper<span class=p>, </span><span class=t>byId</span><span class=p>(</span><span class=s>"photo"</span><span class=p>)),</span>
  <span class=t>bindMask</span><span class=p>(</span>cropper<span class=p>, </span><span class=t>byId</span><span class=p>(</span><span class=s>"mask"</span><span class=p>)),</span>
  <span class=t>bindArea</span><span class=p>(</span>cropper<span class=p>, </span><span class=t>byId</span><span class=p>(</span><span class=s>"area"</span><span class=p>)),</span>
<span class=p>];</span>

<span class=k>const</span> corners <span class=p>= [</span>
  <span class=s>"top-left"</span><span class=p>,</span>
  <span class=s>"top-right"</span><span class=p>,</span>
  <span class=s>"bottom-left"</span><span class=p>,</span>
  <span class=s>"bottom-right"</span><span class=p>,</span>
<span class=p>] </span><span class=k>as const</span><span class=p>;</span>
<span class=k>for </span><span class=p>(</span><span class=k>const</span> corner <span class=k>of</span> corners<span class=p>) {</span>
  <span class=k>const</span> handle <span class=p>=</span> document<span class=p>.</span><span class=t>createElement</span><span class=p>(</span><span class=s>"div"</span><span class=p>);</span>
  handle<span class=p>.</span>dataset<span class=p>.</span>zrizItem <span class=p>= </span><span class=s>"handle"</span><span class=p>;</span>
  handle<span class=p>.</span><span class=t>setAttribute</span><span class=p>(</span><span class=s>"aria-hidden"</span><span class=p>, </span><span class=s>"true"</span><span class=p>);</span>
  <span class=t>byId</span><span class=p>(</span><span class=s>"area"</span><span class=p>).</span><span class=t>append</span><span class=p>(</span>handle<span class=p>);</span>
  cleanups<span class=p>.</span><span class=t>push</span><span class=p>(</span><span class=t>bindHandle</span><span class=p>(</span>cropper<span class=p>,</span> handle<span class=p>,</span> corner<span class=p>));</span>
<span class=p>}</span>

<span class=t>byId</span><span class=p>(</span><span class=s>"file"</span><span class=p>).</span><span class=t>addEventListener</span><span class=p>(</span><span class=s>"change"</span><span class=p>, </span><span class=k>async </span><span class=p>(</span>event<span class=p>) =&gt; {</span>
