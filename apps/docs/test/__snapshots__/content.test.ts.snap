  <span class=a>announce</span><span class=p>={({</span> center<span class=p>,</span> size <span class=p>},</span> details<span class=p>) =&gt; {</span>
    <span class=k>if </span><span class=p>(</span>details<span class=p>.</span>reason <span class=p>!== </span><span class=s>"keyboard"</span><span class=p>) </span><span class=k>return null</span><span class=p>;</span>
    <span class=k>const</span> x <span class=p>=</span> Math<span class=p>.</span><span class=t>round</span><span class=p>(</span>center<span class=p>.</span>x <span class=p>* </span><span class=n>100</span><span class=p>);</span>
    <span class=k>const</span> y <span class=p>=</span> Math<span class=p>.</span><span class=t>round</span><span class=p>(</span>center<span class=p>.</span>y <span class=p>* </span><span class=n>100</span><span class=p>);</span>
    <span class=k>const</span> width <span class=p>=</span> Math<span class=p>.</span><span class=t>round</span><span class=p>(</span>size<span class=p>.</span>width <span class=p>* </span><span class=n>100</span><span class=p>);</span>
    <span class=k>return </span><span class=s>\`Crop at </span><span class=p>\${</span>x<span class=p>}</span><span class=s>%, </span><span class=p>\${</span>y<span class=p>}</span><span class=s>%, </span><span class=p>\${</span>width<span class=p>}</span><span class=s>% wide\`</span><span class=p>;</span>
  <span class=p>}}</span>
<span class=p>/&gt;</span>",
