  <span class=s>"Plus and minus zoom, and 0 resets."</span><span class=p>,</span>
<span class=p>].</span><span class=t>join</span><span class=p>(</span><span class=s>" "</span><span class=p>);</span>

<span class=p>&lt;</span><span class=t>Cropper.Instructions</span><span class=p>&gt;</span>
  <span class=p>{</span>instructions<span class=p>}</span>
<span class=p>&lt;/</span><span class=t>Cropper.Instructions</span><span class=p>&gt;</span>
<span class=p>&lt;</span><span class=t>Cropper.Announcer </span><span class=a>announce</span><span class=p>={</span>announce<span class=p>} /&gt;</span>",
