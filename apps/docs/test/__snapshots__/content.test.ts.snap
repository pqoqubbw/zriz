        <span class=p>&lt;</span><span class=t>Cropper.Viewport </span><span class=a>style</span><span class=p>={{</span> width<span class=p>: </span><span class=n>480</span><span class=p>,</span> height<span class=p>: </span><span class=n>360 </span><span class=p>}}&gt;</span>
          <span class=p>&lt;</span><span class=t>Cropper.Image </span><span class=p>/&gt;</span>
