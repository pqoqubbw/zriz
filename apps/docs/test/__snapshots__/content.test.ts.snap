    "export const canCrop = async (_request: Request) => false;",
    "<span class=k>export const </span><span class=t>canCrop </span><span class=p>= </span><span class=k>async </span><span class=p>(</span>_request<span class=p>:</span> Request<span class=p>) =&gt; </span><span class=n>false</span><span class=p>;</span>",
