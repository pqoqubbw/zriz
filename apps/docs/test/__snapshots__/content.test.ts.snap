  <span class=k>const</span> controller <span class=p>= </span><span class=k>new </span><span class=t>AbortController</span><span class=p>();</span>
  <span class=k>const </span><span class=p>{</span> signal <span class=p>} =</span> controller<span class=p>;</span>

  last <span class=p>=</span> controller<span class=p>;</span>
  <span class=t>byId</span><span class=p>(</span><span class=s>"status"</span><span class=p>).</span>textContent <span class=p>= </span><span class=s>""</span><span class=p>;</span>

  <span class=k>try </span><span class=p>{</span>
    <span class=t>attachImage</span><span class=p>(</span>cropper<span class=p>, </span><span class=k>await </span><span class=t>loadImage</span><span class=p>(</span>file<span class=p>, {</span> signal <span class=p>}));</span>
  <span class=p>} </span><span class=k>catch </span><span class=p>{</span>
