export const MAX_ZOOM = 15;",
    "<span class=k>export const</span> MIN_SIZE <span class=p>= {</span> width<span class=p>: </span><span class=n>1</span><span class=p>,</span> height<span class=p>: </span><span class=n>1 </span><span class=p>};</span>
<span class=k>export const</span> MAX_ZOOM <span class=p>= </span><span class=n>15</span><span class=p>;</span>",
