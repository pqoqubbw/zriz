    cropper<span class=p>.</span><span class=t>setRotation</span><span class=p>(</span>cropper<span class=p>.</span><span class=t>getValue</span><span class=p>().</span>rotation <span class=p>+</span> by<span class=p>, {</span>
      reason<span class=p>: </span><span class=s>"keyboard"</span><span class=p>,</span>
    <span class=p>});</span>
  <span class=p>};</span>
  <span class=k>const </span><span class=t>move </span><span class=p>= (</span>x<span class=p>:</span> number<span class=p>,</span> y<span class=p>:</span> number<span class=p>) =&gt; {</span>
    cropper<span class=p>.</span><span class=t>panBy</span><span class=p>(</span>x<span class=p>,</span> y<span class=p>, {</span> reason<span class=p>: </span><span class=s>"keyboard" </span><span class=p>});</span>
  <span class=p>};</span>
  <span class=k>const </span><span class=t>resize </span><span class=p>= (</span>by<span class=p>:</span> number<span class=p>) =&gt; {</span>
    <span class=k>const</span> state <span class=p>=</span> cropper<span class=p>.</span><span class=t>getCropState</span><span class=p>();</span>
