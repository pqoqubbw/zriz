    <span class=k>try </span><span class=p>{</span>
      <span class=k>const </span><span class=p>{</span> blob <span class=p>} = </span><span class=k>await </span><span class=t>exportCrop</span><span class=p>(</span>actions<span class=p>.</span>current<span class=p>, {</span>
        maxSize<span class=p>: {</span> width<span class=p>: </span><span class=n>512</span><span class=p>,</span> height<span class=p>: </span><span class=n>512 </span><span class=p>},</span>
      <span class=p>});</span>
      <span class=t>setSaveFailed</span><span class=p>(</span><span class=n>false</span><span class=p>);</span>
      <span class=t>onSave</span><span class=p>(</span>blob<span class=p>);</span>
    <span class=p>} </span><span class=k>catch </span><span class=p>{</span>
