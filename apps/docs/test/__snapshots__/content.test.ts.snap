<span class=k>const</span> key <span class=p>= </span><span class=s>\`zriz-crop:</span><span class=p>\${</span>id<span class=p>}</span><span class=s>\`</span><span class=p>;</span>

<span class=k>const </span><span class=p>[</span>saved<span class=p>,</span> setSaved<span class=p>] = </span><span class=t>useState</span><span class=p>&lt;</span>Saved<span class=p>&gt;();</span>

<span class=t>useEffect</span><span class=p>(() =&gt; {</span>
  <span class=t>setSaved</span><span class=p>({</span> id<span class=p>,</span> value<span class=p>: </span><span class=t>parse</span><span class=p>(</span><span class=t>read</span><span class=p>(</span>key<span class=p>)) });</span>
<span class=p>}, [</span>id<span class=p>,</span> key<span class=p>]);</span>

<span class=k>if </span><span class=p>(</span>saved<span class=p>?.</span>id <span class=p>!==</span> id<span class=p>) </span><span class=k>return null</span><span class=p>;</span>",
