          <span class=a>value</span><span class=p>={</span>wide <span class=p>?</span> h <span class=p>/</span> w <span class=p>:</span> w <span class=p>/</span> h<span class=p>}</span>
        <span class=p>&gt;</span>
          <span class=p>{</span>wide <span class=p>? </span><span class=s>\`</span><span class=p>\${</span>h<span class=p>}</span><span class=s>:</span><span class=p>\${</span>w<span class=p>}</span><span class=s>\` </span><span class=p>: </span><span class=s>\`</span><span class=p>\${</span>w<span class=p>}</span><span class=s>:</span><span class=p>\${</span>h<span class=p>}</span><span class=s>\`</span><span class=p>}</span>
