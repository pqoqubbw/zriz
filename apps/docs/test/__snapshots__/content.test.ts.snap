    "errors",
    "errors/save.ts",
    "import type { Cropper } from "@zriz/core";
import { exportCrop, ZrizError } from "@zriz/core/dom";

export const save = async (
  cropper: Cropper,
  signal?: AbortSignal
) => {
  try {
    const { blob } = await exportCrop(cropper, { signal });

    return blob;
  } catch (error) {
    if (
      error instanceof ZrizError &&
      error.code === "aborted"
    ) {
      return null;
    }

    throw error;
  }
};",
    "<span class=k>import type </span><span class=p>{</span> Cropper <span class=p>} </span><span class=k>from </span><span class=s>"@zriz/core"</span><span class=p>;</span>
