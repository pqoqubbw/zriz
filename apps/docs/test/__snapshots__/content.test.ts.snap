  [
    "exporting",
    "exporting/preview.tsx",
    ""use client";

import { exportCrop } from "@zriz/core/dom";
import type { Cropper as CropperApi } from "@zriz/react";
import * as Cropper from "@zriz/react/cropper";
import { useEffect, useRef, useState } from "react";

export const CropWithPreview = ({ file }: { file: File }) => {
  const cropper = useRef<CropperApi>(null);
  const last = useRef<AbortController | null>(null);
  const [preview, setPreview] = useState<string | null>(null);

  useEffect(() => () => last.current?.abort(), []);

  useEffect(
    () => () => {
      if (preview) URL.revokeObjectURL(preview);
    },
    [preview]
  );

  const refresh = async () => {
    if (!cropper.current) return;
    last.current?.abort();
    const controller = new AbortController();

    last.current = controller;

    try {
      const { blob } = await exportCrop(cropper.current, {
        maxSize: { width: 256, height: 256 },
        signal: controller.signal,
      });

      if (!controller.signal.aborted) {
        setPreview(URL.createObjectURL(blob));
      }
    } catch (error) {
      if (!controller.signal.aborted) console.error(error);
    }
  };

  return (
    <>
      <Cropper.Root
        src={file}
        actionsRef={cropper}
        onLoad={() => void refresh()}
        onValueCommit={() => void refresh()}
      >
        <Cropper.Viewport
          style={{ maxWidth: 480, height: 360 }}
        >
          <Cropper.Image />
          <Cropper.Mask />
          <Cropper.Area aria-label="Crop area" />
        </Cropper.Viewport>
      </Cropper.Root>
      {preview && <img src={preview} alt="Crop preview" />}
    </>
  );
};",
    "<span class=s>"use client"</span><span class=p>;</span>

<span class=k>import </span><span class=p>{</span> exportCrop <span class=p>} </span><span class=k>from </span><span class=s>"@zriz/core/dom"</span><span class=p>;</span>
<span class=k>import type </span><span class=p>{</span> Cropper <span class=k>as</span> CropperApi <span class=p>} </span><span class=k>from </span><span class=s>"@zriz/react"</span><span class=p>;</span>
<span class=k>import </span><span class=p>* </span><span class=k>as</span> Cropper <span class=k>from </span><span class=s>"@zriz/react/cropper"</span><span class=p>;</span>
<span class=k>import </span><span class=p>{</span> useEffect<span class=p>,</span> useRef<span class=p>,</span> useState <span class=p>} </span><span class=k>from </span><span class=s>"react"</span><span class=p>;</span>

<span class=k>export const </span><span class=t>CropWithPreview </span><span class=p>= ({</span> file <span class=p>}: {</span> file<span class=p>:</span> File <span class=p>}) =&gt; {</span>
  <span class=k>const</span> cropper <span class=p>= </span><span class=t>useRef</span><span class=p>&lt;</span>CropperApi<span class=p>&gt;(</span><span class=k>null</span><span class=p>);</span>
  <span class=k>const</span> last <span class=p>= </span><span class=t>useRef</span><span class=p>&lt;</span>AbortController <span class=p>|</span> null<span class=p>&gt;(</span><span class=k>null</span><span class=p>);</span>
  <span class=k>const </span><span class=p>[</span>preview<span class=p>,</span> setPreview<span class=p>] = </span><span class=t>useState</span><span class=p>&lt;</span>string <span class=p>|</span> null<span class=p>&gt;(</span><span class=k>null</span><span class=p>);</span>

  <span class=t>useEffect</span><span class=p>(() =&gt; () =&gt;</span> last<span class=p>.</span>current<span class=p>?.</span><span class=t>abort</span><span class=p>(), []);</span>

  <span class=t>useEffect</span><span class=p>(</span>
    <span class=p>() =&gt; () =&gt; {</span>
      <span class=k>if </span><span class=p>(</span>preview<span class=p>)</span> URL<span class=p>.</span><span class=t>revokeObjectURL</span><span class=p>(</span>preview<span class=p>);</span>
    <span class=p>},</span>
    <span class=p>[</span>preview<span class=p>]</span>
  <span class=p>);</span>

  <span class=k>const </span><span class=t>refresh </span><span class=p>= </span><span class=k>async </span><span class=p>() =&gt; {</span>
    <span class=k>if </span><span class=p>(!</span>cropper<span class=p>.</span>current<span class=p>) </span><span class=k>return</span><span class=p>;</span>
    last<span class=p>.</span>current<span class=p>?.</span><span class=t>abort</span><span class=p>();</span>
    <span class=k>const</span> controller <span class=p>= </span><span class=k>new </span><span class=t>AbortController</span><span class=p>();</span>

    last<span class=p>.</span>current <span class=p>=</span> controller<span class=p>;</span>

    <span class=k>try </span><span class=p>{</span>
      <span class=k>const </span><span class=p>{</span> blob <span class=p>} = </span><span class=k>await </span><span class=t>exportCrop</span><span class=p>(</span>cropper<span class=p>.</span>current<span class=p>, {</span>
        maxSize<span class=p>: {</span> width<span class=p>: </span><span class=n>256</span><span class=p>,</span> height<span class=p>: </span><span class=n>256 </span><span class=p>},</span>
        signal<span class=p>:</span> controller<span class=p>.</span>signal<span class=p>,</span>
      <span class=p>});</span>

      <span class=k>if </span><span class=p>(!</span>controller<span class=p>.</span>signal<span class=p>.</span>aborted<span class=p>) {</span>
        <span class=t>setPreview</span><span class=p>(</span>URL<span class=p>.</span><span class=t>createObjectURL</span><span class=p>(</span>blob<span class=p>));</span>
      <span class=p>}</span>
    <span class=p>} </span><span class=k>catch </span><span class=p>(</span>error<span class=p>) {</span>
      <span class=k>if </span><span class=p>(!</span>controller<span class=p>.</span>signal<span class=p>.</span>aborted<span class=p>)</span> console<span class=p>.</span><span class=t>error</span><span class=p>(</span>error<span class=p>);</span>
    <span class=p>}</span>
  <span class=p>};</span>

  <span class=k>return </span><span class=p>(</span>
    <span class=p>&lt;&gt;</span>
      <span class=p>&lt;</span><span class=t>Cropper.Root</span>
        <span class=a>src</span><span class=p>={</span>file<span class=p>}</span>
