      <span class=p>&lt;</span><span class=t>button</span>
        <span class=a>type</span><span class=p>="</span><span class=s>button</span><span class=p>"</span>
        <span class=a>disabled</span><span class=p>={</span>history<span class=p>.</span>length <span class=p>=== </span><span class=n>0</span><span class=p>}</span>
