  <span class=k>const</span> previous <span class=p>=</span> history<span class=p>.</span><span class=t>at</span><span class=p>(-</span><span class=n>1</span><span class=p>);</span>
  <span class=k>if </span><span class=p>(!</span>previous<span class=p>) </span><span class=k>return</span><span class=p>;</span>
