    "cropper",
    "cropper/test.ts",
    "import { createCropper } from "@zriz/core";
import type { Clock } from "@zriz/core";

const queue = new Map<number, (time: number) => void>();
let id = 0;
let now = 0;

const clock: Clock = {
  now: () => now,
  request: (step) => {
    id += 1;
    queue.set(id, step);
    return id;
  },
  cancel: (handle) => {
    queue.delete(handle);
  },
};

const advance = (ms: number) => {
  now += ms;
  const steps = [...queue.values()];
  queue.clear();
  for (const step of steps) step(now);
};

const commits: number[] = [];
const cropper = createCropper({
  clock,
  image: { width: 4032, height: 3024 },
  onValueCommit: (value) => commits.push(value.rotation),
});

cropper.setRotation(7);
advance(16);
console.log(commits);",
    "<span class=k>import </span><span class=p>{</span> createCropper <span class=p>} </span><span class=k>from </span><span class=s>"@zriz/core"</span><span class=p>;</span>
<span class=k>import type </span><span class=p>{</span> Clock <span class=p>} </span><span class=k>from </span><span class=s>"@zriz/core"</span><span class=p>;</span>

<span class=k>const</span> queue <span class=p>= </span><span class=k>new </span><span class=t>Map</span><span class=p>&lt;</span>number<span class=p>, (</span>time<span class=p>:</span> number<span class=p>) =&gt;</span> void<span class=p>&gt;();</span>
<span class=k>let</span> id <span class=p>= </span><span class=n>0</span><span class=p>;</span>
<span class=k>let</span> now <span class=p>= </span><span class=n>0</span><span class=p>;</span>

<span class=k>const</span> clock<span class=p>:</span> Clock <span class=p>= {</span>
  now<span class=p>: () =&gt;</span> now<span class=p>,</span>
  request<span class=p>: (</span>step<span class=p>) =&gt; {</span>
    id <span class=p>+= </span><span class=n>1</span><span class=p>;</span>
    queue<span class=p>.</span><span class=t>set</span><span class=p>(</span>id<span class=p>,</span> step<span class=p>);</span>
    <span class=k>return</span> id<span class=p>;</span>
  <span class=p>},</span>
  cancel<span class=p>: (</span>handle<span class=p>) =&gt; {</span>
    queue<span class=p>.</span><span class=t>delete</span><span class=p>(</span>handle<span class=p>);</span>
  <span class=p>},</span>
<span class=p>};</span>

<span class=k>const </span><span class=t>advance </span><span class=p>= (</span>ms<span class=p>:</span> number<span class=p>) =&gt; {</span>
  now <span class=p>+=</span> ms<span class=p>;</span>
  <span class=k>const</span> steps <span class=p>= [...</span>queue<span class=p>.</span><span class=t>values</span><span class=p>()];</span>
  queue<span class=p>.</span><span class=t>clear</span><span class=p>();</span>
  <span class=k>for </span><span class=p>(</span><span class=k>const</span> step <span class=k>of</span> steps<span class=p>) </span><span class=t>step</span><span class=p>(</span>now<span class=p>);</span>
<span class=p>};</span>

<span class=k>const</span> commits<span class=p>:</span> number<span class=p>[] = [];</span>
<span class=k>const</span> cropper <span class=p>= </span><span class=t>createCropper</span><span class=p>({</span>
  clock<span class=p>,</span>
  image<span class=p>: {</span> width<span class=p>: </span><span class=n>4032</span><span class=p>,</span> height<span class=p>: </span><span class=n>3024 </span><span class=p>},</span>
  onValueCommit<span class=p>: (</span>value<span class=p>) =&gt;</span> commits<span class=p>.</span><span class=t>push</span><span class=p>(</span>value<span class=p>.</span>rotation<span class=p>),</span>
<span class=p>});</span>

cropper<span class=p>.</span><span class=t>setRotation</span><span class=p>(</span><span class=n>7</span><span class=p>);</span>
<span class=t>advance</span><span class=p>(</span><span class=n>16</span><span class=p>);</span>
