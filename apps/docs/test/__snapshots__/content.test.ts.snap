          <span class=t>setFile</span><span class=p>(</span>event<span class=p>.</span>target<span class=p>.</span>files<span class=p>?.[</span><span class=n>0</span><span class=p>] ?? </span><span class=k>null</span><span class=p>);</span>
        <span class=p>}}</span>
      <span class=p>/&gt;</span>
      <span class=p>&lt;</span><span class=t>Cropper.Root</span>
        <span class=a>key</span><span class=p>={</span>picks<span class=p>}</span>
        <span class=a>actionsRef</span><span class=p>={</span>actions<span class=p>}</span>
        <span class=a>src</span><span class=p>={</span>file<span class=p>}</span>
        <span class=a>shape</span><span class=p>="</span><span class=s>circle</span><span class=p>"</span>
        <span class=a>minSize</span><span class=p>={{</span> width<span class=p>: </span><span class=n>512</span><span class=p>,</span> height<span class=p>: </span><span class=n>512 </span><span class=p>}}</span>
        <span class=a>onLoad</span><span class=p>={() =&gt; </span><span class=t>setStatus</span><span class=p>(</span><span class=s>"ready"</span><span class=p>)}</span>
