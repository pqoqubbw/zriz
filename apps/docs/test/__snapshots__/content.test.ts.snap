    "server-crop",
    "server-crop/app/api/crop/route.ts",
    "import { createCropper, parse, toSharp } from "@zriz/core";
import sharp from "sharp";
import type { OutputInfo, Sharp } from "sharp";
import { canCrop } from "../../../can-crop";
import { MAX_ZOOM, MIN_SIZE } from "../../../crop-limits";

const MAX_BODY = 50 * 1024 * 1024;
const MAX_VALUE = 4096;
const MAX_PIXELS = 120_000_000;
const MAX_RUNNING = 2;
const MAX_SECONDS = 30;
const HEADERS = {
  "cache-control": "private, no-store",
  "x-content-type-options": "nosniff",
};

sharp.block({ operation: ["VipsForeignLoad"] });

sharp.unblock({
  operation: [
    "VipsForeignLoadJpegBuffer",
    "VipsForeignLoadPngBuffer",
    "VipsForeignLoadWebpBuffer",
    "VipsForeignLoadHeifBuffer",
  ],
});

let running = 0;

const refuse = (text: string, status: number) =>
  new Response(text, { headers: HEADERS, status });

type Raw = { data: Buffer; info: OutputInfo };
const open = (image: Raw) =>
  sharp(image.data, {
    raw: image.info,
    limitInputPixels: false,
  });
const raw = (pipeline: Sharp) =>
  pipeline
    .timeout({ seconds: MAX_SECONDS })
    .raw()
    .toBuffer({ resolveWithObject: true });

const cut = async (input: Buffer, value: string) => {
  const saved = parse(value);

  if (!saved) throw new TypeError("not a crop value");
  const upright = await raw(
    sharp(input, { limitInputPixels: MAX_PIXELS }).rotate()
  );
  const cropper = createCropper({
    image: upright.info,
    maxZoom: MAX_ZOOM,
    minSize: MIN_SIZE,
  });

  cropper.setValue(saved);
  const plan = cropper.getPixelCrop();

  if (!plan || plan.homography)
    throw new RangeError("no flat plan");
  const steps = toSharp(plan, upright.info);

  if (steps.kind === "extract") {
    const turned = await raw(
      open(upright)
        .extract(steps.extract)
        .flop(steps.flop)
        .rotate(steps.rotate)
    );

    return open(turned).resize({
      ...steps.resize,
      fit: "fill",
    });
  }

  const [[a, b], [c, d]] = steps.affine;
  const padded = await raw(
    open(upright).extract(steps.source).extend(steps.extend)
  );
  const turned = await raw(
    open(padded).affine([a, b, c, d], steps.options)
  );

  return open(turned).extract(steps.extract);
};

const readForm = async (request: Request) => {
  let seen = 0;
  const capped = request.body?.pipeThrough(
    new TransformStream<Uint8Array, Uint8Array>({
      transform(chunk, stream) {
        seen += chunk.length;
        if (seen > MAX_BODY) stream.error(new RangeError());
        else stream.enqueue(chunk);
      },
    })
  );
  const form = await new Response(capped, {
    headers: request.headers,
  })
    .formData()
    .catch(() => null);

  return { form, over: seen > MAX_BODY };
};

const answer = async (request: Request) => {
  const { form, over } = await readForm(request);

  if (over) return refuse("this upload is too large.", 413);
  const file = form?.get("file");
  const value = form?.get("value");

  if (
    !(file instanceof File) ||
    file.size === 0 ||
    typeof value !== "string"
  ) {
    return refuse("send a file and a crop value.", 400);
  }

  if (value.length > MAX_VALUE) {
    return refuse("this crop does not fit this photo.", 422);
  }

  const input = Buffer.from(await file.arrayBuffer());
  const meta = await sharp(input)
    .metadata()
    .catch(() => null);

  if (!meta) return refuse("sharp cannot open this file.", 400);

  if (meta.format === "heif" && meta.compression !== "av1") {
    return refuse("send a jpeg, png, webp or avif.", 415);
  }

  if (meta.width * meta.height > MAX_PIXELS) {
    return refuse("this photo has too many pixels.", 413);
  }

  if (meta.format === "webp" && (meta.orientation ?? 1) > 1) {
    return refuse(
      "save this webp without an orientation tag.",
      422
    );
  }

  try {
    const crop = await cut(input, value);
    const jpeg = await crop
      .timeout({ seconds: MAX_SECONDS })
      .flatten({ background: "#ffffff" })
      .jpeg({ quality: 92 })
      .toBuffer();

    return new Response(new Uint8Array(jpeg), {
      headers: { ...HEADERS, "content-type": "image/jpeg" },
    });
  } catch {
    return refuse("this crop does not fit this photo.", 422);
  }
};

export const POST = async (request: Request) => {
  if (!(await canCrop(request))) {
    return refuse("sign in to crop a photo.", 401);
  }

  const length = Number(request.headers.get("content-length"));

  if (!(length > 0) || length > MAX_BODY) {
    return refuse("this upload is too large.", 413);
  }

  if (running >= MAX_RUNNING) {
    return refuse("the server is busy. try again.", 503);
  }

  running += 1;

  try {
    return await answer(request);
  } finally {
    running -= 1;
  }
};",
    "<span class=k>import </span><span class=p>{</span> createCropper<span class=p>,</span> parse<span class=p>,</span> toSharp <span class=p>} </span><span class=k>from </span><span class=s>"@zriz/core"</span><span class=p>;</span>
<span class=k>import</span> sharp <span class=k>from </span><span class=s>"sharp"</span><span class=p>;</span>
<span class=k>import type </span><span class=p>{</span> OutputInfo<span class=p>,</span> Sharp <span class=p>} </span><span class=k>from </span><span class=s>"sharp"</span><span class=p>;</span>
<span class=k>import </span><span class=p>{</span> canCrop <span class=p>} </span><span class=k>from </span><span class=s>"../../../can-crop"</span><span class=p>;</span>
<span class=k>import </span><span class=p>{</span> MAX_ZOOM<span class=p>,</span> MIN_SIZE <span class=p>} </span><span class=k>from </span><span class=s>"../../../crop-limits"</span><span class=p>;</span>

<span class=k>const</span> MAX_BODY <span class=p>= </span><span class=n>50 </span><span class=p>* </span><span class=n>1024 </span><span class=p>* </span><span class=n>1024</span><span class=p>;</span>
<span class=k>const</span> MAX_VALUE <span class=p>= </span><span class=n>4096</span><span class=p>;</span>
<span class=k>const</span> MAX_PIXELS <span class=p>= </span><span class=n>120_000_000</span><span class=p>;</span>
<span class=k>const</span> MAX_RUNNING <span class=p>= </span><span class=n>2</span><span class=p>;</span>
<span class=k>const</span> MAX_SECONDS <span class=p>= </span><span class=n>30</span><span class=p>;</span>
<span class=k>const</span> HEADERS <span class=p>= {</span>
  <span class=s>"</span>cache-control<span class=s>"</span><span class=p>: </span><span class=s>"private, no-store"</span><span class=p>,</span>
  <span class=s>"</span>x-content-type-options<span class=s>"</span><span class=p>: </span><span class=s>"nosniff"</span><span class=p>,</span>
<span class=p>};</span>

sharp<span class=p>.</span><span class=t>block</span><span class=p>({</span> operation<span class=p>: [</span><span class=s>"VipsForeignLoad"</span><span class=p>] });</span>

sharp<span class=p>.</span><span class=t>unblock</span><span class=p>({</span>
  operation<span class=p>: [</span>
    <span class=s>"VipsForeignLoadJpegBuffer"</span><span class=p>,</span>
    <span class=s>"VipsForeignLoadPngBuffer"</span><span class=p>,</span>
    <span class=s>"VipsForeignLoadWebpBuffer"</span><span class=p>,</span>
    <span class=s>"VipsForeignLoadHeifBuffer"</span><span class=p>,</span>
  <span class=p>],</span>
<span class=p>});</span>

<span class=k>let</span> running <span class=p>= </span><span class=n>0</span><span class=p>;</span>

<span class=k>const </span><span class=t>refuse </span><span class=p>= (</span>text<span class=p>:</span> string<span class=p>,</span> status<span class=p>:</span> number<span class=p>) =&gt;</span>
  <span class=k>new </span><span class=t>Response</span><span class=p>(</span>text<span class=p>, {</span> headers<span class=p>:</span> HEADERS<span class=p>,</span> status <span class=p>});</span>

<span class=k>type</span> Raw <span class=p>= {</span> data<span class=p>:</span> Buffer<span class=p>;</span> info<span class=p>:</span> OutputInfo <span class=p>};</span>
<span class=k>const </span><span class=t>open </span><span class=p>= (</span>image<span class=p>:</span> Raw<span class=p>) =&gt;</span>
  <span class=t>sharp</span><span class=p>(</span>image<span class=p>.</span>data<span class=p>, {</span>
    raw<span class=p>:</span> image<span class=p>.</span>info<span class=p>,</span>
    limitInputPixels<span class=p>: </span><span class=n>false</span><span class=p>,</span>
  <span class=p>});</span>
<span class=k>const </span><span class=t>raw </span><span class=p>= (</span>pipeline<span class=p>:</span> Sharp<span class=p>) =&gt;</span>
  pipeline
    <span class=p>.</span><span class=t>timeout</span><span class=p>({</span> seconds<span class=p>:</span> MAX_SECONDS <span class=p>})</span>
    <span class=p>.</span><span class=t>raw</span><span class=p>()</span>
    <span class=p>.</span><span class=t>toBuffer</span><span class=p>({</span> resolveWithObject<span class=p>: </span><span class=n>true </span><span class=p>});</span>

<span class=k>const </span><span class=t>cut </span><span class=p>= </span><span class=k>async </span><span class=p>(</span>input<span class=p>:</span> Buffer<span class=p>,</span> value<span class=p>:</span> string<span class=p>) =&gt; {</span>
  <span class=k>const</span> saved <span class=p>= </span><span class=t>parse</span><span class=p>(</span>value<span class=p>);</span>

  <span class=k>if </span><span class=p>(!</span>saved<span class=p>) </span><span class=k>throw new </span><span class=t>TypeError</span><span class=p>(</span><span class=s>"not a crop value"</span><span class=p>);</span>
  <span class=k>const</span> upright <span class=p>= </span><span class=k>await </span><span class=t>raw</span><span class=p>(</span>
    <span class=t>sharp</span><span class=p>(</span>input<span class=p>, {</span> limitInputPixels<span class=p>:</span> MAX_PIXELS <span class=p>}).</span><span class=t>rotate</span><span class=p>()</span>
  <span class=p>);</span>
  <span class=k>const</span> cropper <span class=p>= </span><span class=t>createCropper</span><span class=p>({</span>
    image<span class=p>:</span> upright<span class=p>.</span>info<span class=p>,</span>
    maxZoom<span class=p>:</span> MAX_ZOOM<span class=p>,</span>
    minSize<span class=p>:</span> MIN_SIZE<span class=p>,</span>
  <span class=p>});</span>

  cropper<span class=p>.</span><span class=t>setValue</span><span class=p>(</span>saved<span class=p>);</span>
  <span class=k>const</span> plan <span class=p>=</span> cropper<span class=p>.</span><span class=t>getPixelCrop</span><span class=p>();</span>

  <span class=k>if </span><span class=p>(!</span>plan <span class=p>||</span> plan<span class=p>.</span>homography<span class=p>)</span>
    <span class=k>throw new </span><span class=t>RangeError</span><span class=p>(</span><span class=s>"no flat plan"</span><span class=p>);</span>
  <span class=k>const</span> steps <span class=p>= </span><span class=t>toSharp</span><span class=p>(</span>plan<span class=p>,</span> upright<span class=p>.</span>info<span class=p>);</span>

  <span class=k>if </span><span class=p>(</span>steps<span class=p>.</span>kind <span class=p>=== </span><span class=s>"extract"</span><span class=p>) {</span>
    <span class=k>const</span> turned <span class=p>= </span><span class=k>await </span><span class=t>raw</span><span class=p>(</span>
      <span class=t>open</span><span class=p>(</span>upright<span class=p>)</span>
        <span class=p>.</span><span class=t>extract</span><span class=p>(</span>steps<span class=p>.</span>extract<span class=p>)</span>
        <span class=p>.</span><span class=t>flop</span><span class=p>(</span>steps<span class=p>.</span>flop<span class=p>)</span>
        <span class=p>.</span><span class=t>rotate</span><span class=p>(</span>steps<span class=p>.</span>rotate<span class=p>)</span>
    <span class=p>);</span>

    <span class=k>return </span><span class=t>open</span><span class=p>(</span>turned<span class=p>).</span><span class=t>resize</span><span class=p>({</span>
      <span class=p>...</span>steps<span class=p>.</span>resize<span class=p>,</span>
      fit<span class=p>: </span><span class=s>"fill"</span><span class=p>,</span>
    <span class=p>});</span>
  <span class=p>}</span>

  <span class=k>const </span><span class=p>[[</span>a<span class=p>,</span> b<span class=p>], [</span>c<span class=p>,</span> d<span class=p>]] =</span> steps<span class=p>.</span>affine<span class=p>;</span>
  <span class=k>const</span> padded <span class=p>= </span><span class=k>await </span><span class=t>raw</span><span class=p>(</span>
    <span class=t>open</span><span class=p>(</span>upright<span class=p>).</span><span class=t>extract</span><span class=p>(</span>steps<span class=p>.</span>source<span class=p>).</span><span class=t>extend</span><span class=p>(</span>steps<span class=p>.</span>extend<span class=p>)</span>
  <span class=p>);</span>
  <span class=k>const</span> turned <span class=p>= </span><span class=k>await </span><span class=t>raw</span><span class=p>(</span>
    <span class=t>open</span><span class=p>(</span>padded<span class=p>).</span><span class=t>affine</span><span class=p>([</span>a<span class=p>,</span> b<span class=p>,</span> c<span class=p>,</span> d<span class=p>],</span> steps<span class=p>.</span>options<span class=p>)</span>
  <span class=p>);</span>

  <span class=k>return </span><span class=t>open</span><span class=p>(</span>turned<span class=p>).</span><span class=t>extract</span><span class=p>(</span>steps<span class=p>.</span>extract<span class=p>);</span>
<span class=p>};</span>

<span class=k>const </span><span class=t>readForm </span><span class=p>= </span><span class=k>async </span><span class=p>(</span>request<span class=p>:</span> Request<span class=p>) =&gt; {</span>
  <span class=k>let</span> seen <span class=p>= </span><span class=n>0</span><span class=p>;</span>
  <span class=k>const</span> capped <span class=p>=</span> request<span class=p>.</span>body<span class=p>?.</span><span class=t>pipeThrough</span><span class=p>(</span>
    <span class=k>new </span><span class=t>TransformStream</span><span class=p>&lt;</span>Uint8Array<span class=p>,</span> Uint8Array<span class=p>&gt;({</span>
      <span class=t>transform</span><span class=p>(</span>chunk<span class=p>,</span> stream<span class=p>) {</span>
        seen <span class=p>+=</span> chunk<span class=p>.</span>length<span class=p>;</span>
        <span class=k>if </span><span class=p>(</span>seen <span class=p>&gt;</span> MAX_BODY<span class=p>)</span> stream<span class=p>.</span><span class=t>error</span><span class=p>(</span><span class=k>new </span><span class=t>RangeError</span><span class=p>());</span>
        <span class=k>else</span> stream<span class=p>.</span><span class=t>enqueue</span><span class=p>(</span>chunk<span class=p>);</span>
      <span class=p>},</span>
    <span class=p>})</span>
  <span class=p>);</span>
  <span class=k>const</span> form <span class=p>= </span><span class=k>await new </span><span class=t>Response</span><span class=p>(</span>capped<span class=p>, {</span>
    headers<span class=p>:</span> request<span class=p>.</span>headers<span class=p>,</span>
  <span class=p>})</span>
    <span class=p>.</span><span class=t>formData</span><span class=p>()</span>
    <span class=p>.</span><span class=t>catch</span><span class=p>(() =&gt; </span><span class=k>null</span><span class=p>);</span>

  <span class=k>return </span><span class=p>{</span> form<span class=p>,</span> over<span class=p>:</span> seen <span class=p>&gt;</span> MAX_BODY <span class=p>};</span>
<span class=p>};</span>

<span class=k>const </span><span class=t>answer </span><span class=p>= </span><span class=k>async </span><span class=p>(</span>request<span class=p>:</span> Request<span class=p>) =&gt; {</span>
  <span class=k>const </span><span class=p>{</span> form<span class=p>,</span> over <span class=p>} = </span><span class=k>await </span><span class=t>readForm</span><span class=p>(</span>request<span class=p>);</span>

  <span class=k>if </span><span class=p>(</span>over<span class=p>) </span><span class=k>return </span><span class=t>refuse</span><span class=p>(</span><span class=s>"this upload is too large."</span><span class=p>, </span><span class=n>413</span><span class=p>);</span>
  <span class=k>const</span> file <span class=p>=</span> form<span class=p>?.</span><span class=t>get</span><span class=p>(</span><span class=s>"file"</span><span class=p>);</span>
  <span class=k>const</span> value <span class=p>=</span> form<span class=p>?.</span><span class=t>get</span><span class=p>(</span><span class=s>"value"</span><span class=p>);</span>

  <span class=k>if </span><span class=p>(</span>
    <span class=p>!(</span>file <span class=k>instanceof</span> File<span class=p>) ||</span>
    file<span class=p>.</span>size <span class=p>=== </span><span class=n>0 </span><span class=p>||</span>
    <span class=k>typeof</span> value <span class=p>!== </span><span class=s>"string"</span>
  <span class=p>) {</span>
    <span class=k>return </span><span class=t>refuse</span><span class=p>(</span><span class=s>"send a file and a crop value."</span><span class=p>, </span><span class=n>400</span><span class=p>);</span>
  <span class=p>}</span>

  <span class=k>if </span><span class=p>(</span>value<span class=p>.</span>length <span class=p>&gt;</span> MAX_VALUE<span class=p>) {</span>
    <span class=k>return </span><span class=t>refuse</span><span class=p>(</span><span class=s>"this crop does not fit this photo."</span><span class=p>, </span><span class=n>422</span><span class=p>);</span>
  <span class=p>}</span>

  <span class=k>const</span> input <span class=p>=</span> Buffer<span class=p>.</span><span class=t>from</span><span class=p>(</span><span class=k>await</span> file<span class=p>.</span><span class=t>arrayBuffer</span><span class=p>());</span>
  <span class=k>const</span> meta <span class=p>= </span><span class=k>await </span><span class=t>sharp</span><span class=p>(</span>input<span class=p>)</span>
    <span class=p>.</span><span class=t>metadata</span><span class=p>()</span>
    <span class=p>.</span><span class=t>catch</span><span class=p>(() =&gt; </span><span class=k>null</span><span class=p>);</span>

  <span class=k>if </span><span class=p>(!</span>meta<span class=p>) </span><span class=k>return </span><span class=t>refuse</span><span class=p>(</span><span class=s>"sharp cannot open this file."</span><span class=p>, </span><span class=n>400</span><span class=p>);</span>

  <span class=k>if </span><span class=p>(</span>meta<span class=p>.</span>format <span class=p>=== </span><span class=s>"heif" </span><span class=p>&amp;&amp;</span> meta<span class=p>.</span>compression <span class=p>!== </span><span class=s>"av1"</span><span class=p>) {</span>
    <span class=k>return </span><span class=t>refuse</span><span class=p>(</span><span class=s>"send a jpeg, png, webp or avif."</span><span class=p>, </span><span class=n>415</span><span class=p>);</span>
  <span class=p>}</span>

  <span class=k>if </span><span class=p>(</span>meta<span class=p>.</span>width <span class=p>*</span> meta<span class=p>.</span>height <span class=p>&gt;</span> MAX_PIXELS<span class=p>) {</span>
    <span class=k>return </span><span class=t>refuse</span><span class=p>(</span><span class=s>"this photo has too many pixels."</span><span class=p>, </span><span class=n>413</span><span class=p>);</span>
  <span class=p>}</span>

  <span class=k>if </span><span class=p>(</span>meta<span class=p>.</span>format <span class=p>=== </span><span class=s>"webp" </span><span class=p>&amp;&amp; (</span>meta<span class=p>.</span>orientation <span class=p>?? </span><span class=n>1</span><span class=p>) &gt; </span><span class=n>1</span><span class=p>) {</span>
    <span class=k>return </span><span class=t>refuse</span><span class=p>(</span>
      <span class=s>"save this webp without an orientation tag."</span><span class=p>,</span>
      <span class=n>422</span>
    <span class=p>);</span>
  <span class=p>}</span>

  <span class=k>try </span><span class=p>{</span>
    <span class=k>const</span> crop <span class=p>= </span><span class=k>await </span><span class=t>cut</span><span class=p>(</span>input<span class=p>,</span> value<span class=p>);</span>
    <span class=k>const</span> jpeg <span class=p>= </span><span class=k>await</span> crop
      <span class=p>.</span><span class=t>timeout</span><span class=p>({</span> seconds<span class=p>:</span> MAX_SECONDS <span class=p>})</span>
      <span class=p>.</span><span class=t>flatten</span><span class=p>({</span> background<span class=p>: </span><span class=s>"#ffffff" </span><span class=p>})</span>
      <span class=p>.</span><span class=t>jpeg</span><span class=p>({</span> quality<span class=p>: </span><span class=n>92 </span><span class=p>})</span>
      <span class=p>.</span><span class=t>toBuffer</span><span class=p>();</span>

    <span class=k>return new </span><span class=t>Response</span><span class=p>(</span><span class=k>new </span><span class=t>Uint8Array</span><span class=p>(</span>jpeg<span class=p>), {</span>
      headers<span class=p>: { ...</span>HEADERS<span class=p>, </span><span class=s>"</span>content-type<span class=s>"</span><span class=p>: </span><span class=s>"image/jpeg" </span><span class=p>},</span>
    <span class=p>});</span>
  <span class=p>} </span><span class=k>catch </span><span class=p>{</span>
    <span class=k>return </span><span class=t>refuse</span><span class=p>(</span><span class=s>"this crop does not fit this photo."</span><span class=p>, </span><span class=n>422</span><span class=p>);</span>
  <span class=p>}</span>
<span class=p>};</span>

<span class=k>export const </span><span class=t>POST </span><span class=p>= </span><span class=k>async </span><span class=p>(</span>request<span class=p>:</span> Request<span class=p>) =&gt; {</span>
  <span class=k>if </span><span class=p>(!(</span><span class=k>await </span><span class=t>canCrop</span><span class=p>(</span>request<span class=p>))) {</span>
    <span class=k>return </span><span class=t>refuse</span><span class=p>(</span><span class=s>"sign in to crop a photo."</span><span class=p>, </span><span class=n>401</span><span class=p>);</span>
  <span class=p>}</span>

  <span class=k>const</span> length <span class=p>= </span><span class=t>Number</span><span class=p>(</span>request<span class=p>.</span>headers<span class=p>.</span><span class=t>get</span><span class=p>(</span><span class=s>"content-length"</span><span class=p>));</span>

  <span class=k>if </span><span class=p>(!(</span>length <span class=p>&gt; </span><span class=n>0</span><span class=p>) ||</span> length <span class=p>&gt;</span> MAX_BODY<span class=p>) {</span>
    <span class=k>return </span><span class=t>refuse</span><span class=p>(</span><span class=s>"this upload is too large."</span><span class=p>, </span><span class=n>413</span><span class=p>);</span>
  <span class=p>}</span>

  <span class=k>if </span><span class=p>(</span>running <span class=p>&gt;=</span> MAX_RUNNING<span class=p>) {</span>
    <span class=k>return </span><span class=t>refuse</span><span class=p>(</span><span class=s>"the server is busy. try again."</span><span class=p>, </span><span class=n>503</span><span class=p>);</span>
  <span class=p>}</span>

  running <span class=p>+= </span><span class=n>1</span><span class=p>;</span>

  <span class=k>try </span><span class=p>{</span>
    <span class=k>return await </span><span class=t>answer</span><span class=p>(</span>request<span class=p>);</span>
  <span class=p>} </span><span class=k>finally </span><span class=p>{</span>
    running <span class=p>-= </span><span class=n>1</span><span class=p>;</span>
  <span class=p>}</span>
<span class=p>};</span>",
