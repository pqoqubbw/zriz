    "undo",
    "undo/undo-editor.tsx",
    ""use client";

import type {
  CommitDetails,
  Cropper as CropperApi,
  CropValue,
} from "@zriz/react";
import * as Cropper from "@zriz/react/cropper";
import "@zriz/react/styles.css";
import { useRef, useState } from "react";

const skipped = new Set(["history", "coverage"]);

export const UndoEditor = ({ src }: { src: string }) => {
  const actions = useRef<CropperApi>(null);
  const [history, setHistory] = useState<CropValue[]>([]);

  const remember = (_: CropValue, details: CommitDetails) => {
    if (skipped.has(details.reason)) return;
    setHistory((stack) =>
      [...stack, details.previous].slice(-50)
    );
  };

  const undo = () => {
    const previous = history.at(-1);
    if (!previous) return;
    setHistory(history.slice(0, -1));
    actions.current?.setValue(previous, { reason: "history" });
  };

  return (
    <Cropper.Root
      actionsRef={actions}
      src={src}
      onLoad={() => setHistory([])}
      onValueCommit={remember}
    >
      <Cropper.Viewport style={{ width: 640, height: 480 }}>
        <Cropper.Image />
        <Cropper.Mask />
        <Cropper.Area aria-label="Crop area" />
      </Cropper.Viewport>
      <Cropper.Dial
        aria-label="Straighten"
        style={{ width: 361 }}
      >
        <Cropper.DialTicks />
      </Cropper.Dial>
      <button
        type="button"
        disabled={history.length === 0}
        onClick={undo}
      >
        undo
      </button>
    </Cropper.Root>
  );
};",
    "<span class=s>"use client"</span><span class=p>;</span>

<span class=k>import type </span><span class=p>{</span>
  CommitDetails<span class=p>,</span>
  Cropper <span class=k>as</span> CropperApi<span class=p>,</span>
  CropValue<span class=p>,</span>
<span class=p>} </span><span class=k>from </span><span class=s>"@zriz/react"</span><span class=p>;</span>
<span class=k>import </span><span class=p>* </span><span class=k>as</span> Cropper <span class=k>from </span><span class=s>"@zriz/react/cropper"</span><span class=p>;</span>
<span class=k>import </span><span class=s>"@zriz/react/styles.css"</span><span class=p>;</span>
<span class=k>import </span><span class=p>{</span> useRef<span class=p>,</span> useState <span class=p>} </span><span class=k>from </span><span class=s>"react"</span><span class=p>;</span>

<span class=k>const</span> skipped <span class=p>= </span><span class=k>new </span><span class=t>Set</span><span class=p>([</span><span class=s>"history"</span><span class=p>, </span><span class=s>"coverage"</span><span class=p>]);</span>

<span class=k>export const </span><span class=t>UndoEditor </span><span class=p>= ({</span> src <span class=p>}: {</span> src<span class=p>:</span> string <span class=p>}) =&gt; {</span>
  <span class=k>const</span> actions <span class=p>= </span><span class=t>useRef</span><span class=p>&lt;</span>CropperApi<span class=p>&gt;(</span><span class=k>null</span><span class=p>);</span>
  <span class=k>const </span><span class=p>[</span>history<span class=p>,</span> setHistory<span class=p>] = </span><span class=t>useState</span><span class=p>&lt;</span>CropValue<span class=p>[]&gt;([]);</span>

  <span class=k>const </span><span class=t>remember </span><span class=p>= (</span>_<span class=p>:</span> CropValue<span class=p>,</span> details<span class=p>:</span> CommitDetails<span class=p>) =&gt; {</span>
    <span class=k>if </span><span class=p>(</span>skipped<span class=p>.</span><span class=t>has</span><span class=p>(</span>details<span class=p>.</span>reason<span class=p>)) </span><span class=k>return</span><span class=p>;</span>
    <span class=t>setHistory</span><span class=p>((</span>stack<span class=p>) =&gt;</span>
      <span class=p>[...</span>stack<span class=p>,</span> details<span class=p>.</span>previous<span class=p>].</span><span class=t>slice</span><span class=p>(-</span><span class=n>50</span><span class=p>)</span>
    <span class=p>);</span>
  <span class=p>};</span>

  <span class=k>const </span><span class=t>undo </span><span class=p>= () =&gt; {</span>
    <span class=k>const</span> previous <span class=p>=</span> history<span class=p>.</span><span class=t>at</span><span class=p>(-</span><span class=n>1</span><span class=p>);</span>
    <span class=k>if </span><span class=p>(!</span>previous<span class=p>) </span><span class=k>return</span><span class=p>;</span>
    <span class=t>setHistory</span><span class=p>(</span>history<span class=p>.</span><span class=t>slice</span><span class=p>(</span><span class=n>0</span><span class=p>, -</span><span class=n>1</span><span class=p>));</span>
    actions<span class=p>.</span>current<span class=p>?.</span><span class=t>setValue</span><span class=p>(</span>previous<span class=p>, {</span> reason<span class=p>: </span><span class=s>"history" </span><span class=p>});</span>
  <span class=p>};</span>

  <span class=k>return </span><span class=p>(</span>
    <span class=p>&lt;</span><span class=t>Cropper.Root</span>
      <span class=a>actionsRef</span><span class=p>={</span>actions<span class=p>}</span>
      <span class=a>src</span><span class=p>={</span>src<span class=p>}</span>
      <span class=a>onLoad</span><span class=p>={() =&gt; </span><span class=t>setHistory</span><span class=p>([])}</span>
      <span class=a>onValueCommit</span><span class=p>={</span>remember<span class=p>}</span>
    <span class=p>&gt;</span>
      <span class=p>&lt;</span><span class=t>Cropper.Viewport </span><span class=a>style</span><span class=p>={{</span> width<span class=p>: </span><span class=n>640</span><span class=p>,</span> height<span class=p>: </span><span class=n>480 </span><span class=p>}}&gt;</span>
        <span class=p>&lt;</span><span class=t>Cropper.Image </span><span class=p>/&gt;</span>
        <span class=p>&lt;</span><span class=t>Cropper.Mask </span><span class=p>/&gt;</span>
        <span class=p>&lt;</span><span class=t>Cropper.Area </span><span class=a>aria-label</span><span class=p>="</span><span class=s>Crop area</span><span class=p>" /&gt;</span>
      <span class=p>&lt;/</span><span class=t>Cropper.Viewport</span><span class=p>&gt;</span>
      <span class=p>&lt;</span><span class=t>Cropper.Dial</span>
        <span class=a>aria-label</span><span class=p>="</span><span class=s>Straighten</span><span class=p>"</span>
        <span class=a>style</span><span class=p>={{</span> width<span class=p>: </span><span class=n>361 </span><span class=p>}}</span>
      <span class=p>&gt;</span>
