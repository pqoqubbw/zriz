  document<span class=p>.</span><span class=t>getElementById</span><span class=p>(</span>id<span class=p>) </span><span class=k>as</span> HTMLElement<span class=p>;</span>

<span class=k>export const</span> cropper <span class=p>= </span><span class=t>createCropper</span><span class=p>({</span>
  defaultValue<span class=p>: {</span> aspect<span class=p>: </span><span class=n>4 </span><span class=p>/ </span><span class=n>3 </span><span class=p>},</span>
