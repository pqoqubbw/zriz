  [
    "full-editor",
    "full-editor/editor.tsx",
    ""use client";

import { exportCrop } from "@zriz/core/dom";
import type {
  ChangeReason,
  CommitDetails,
  Cropper as CropperApi,
  CropValue,
} from "@zriz/react";
import * as Cropper from "@zriz/react/cropper";
import "@zriz/react/styles.css";
import { useEffect, useRef, useState } from "react";
import "./forced-colors.css";

const handles = [
  "top-left",
  "top",
  "top-right",
  "right",
  "bottom-right",
  "bottom",
  "bottom-left",
  "left",
] as const;

const track = {
  width: 200,
  height: 24,
  backgroundImage:
    "linear-gradient(currentColor, currentColor)",
  backgroundSize: "100% 2px",
  backgroundPosition: "center",
  backgroundRepeat: "no-repeat",
};

const thumb = {
  top: 4,
  width: 16,
  height: 16,
  borderRadius: 8,
  background: "currentColor",
  translate: "-50%",
};

const aspects = [
  { label: "free", value: "free" },
  { label: "original", value: "original" },
  { label: "square", value: 1 },
  { label: "4:5", value: 4 / 5 },
  { label: "16:9", value: 16 / 9 },
] as const;

const spoken: Partial<Record<ChangeReason, string>> = {
  "rotate-90": "Turned 90 degrees",
  flip: "Flipped",
  orientation: "Orientation swapped",
  reset: "Crop reset",
};

const announce = (_: CropValue, details: CommitDetails) =>
  spoken[details.reason] ?? null;

const instructions = [
  "Drag the photo to move it.",
  "Arrows move the crop. Alt and arrows resize it.",
  "Plus and minus zoom, and 0 resets.",
].join(" ");

type Props = { src: string; onSave: (jpeg: Blob) => void };

export const Editor = ({ src, onSave }: Props) => {
  const actions = useRef<CropperApi>(null);
  const running = useRef<AbortController | null>(null);
  const [saving, setSaving] = useState(false);
  const [ready, setReady] = useState(false);
  const [failed, setFailed] = useState(false);
  const [exportFailed, setExportFailed] = useState(false);
  const [shown, setShown] = useState(src);

  if (shown !== src) {
    setShown(src);
    setReady(false);
    setFailed(false);
    setExportFailed(false);
  }

  useEffect(() => () => running.current?.abort(), [src]);

  const save = async () => {
    if (!actions.current || running.current) return;
    const controller = new AbortController();

    running.current = controller;
    setSaving(true);
    setExportFailed(false);

    try {
      const { blob } = await exportCrop(actions.current, {
        signal: controller.signal,
      });

      onSave(blob);
    } catch {
      setExportFailed(!controller.signal.aborted);
    } finally {
      running.current = null;
      setSaving(false);
    }
  };

  return (
    <Cropper.Root
      key={src}
      actionsRef={actions}
      src={src}
      onLoad={() => setReady(true)}
      onError={() => setFailed(true)}
    >
      <Cropper.Viewport
        style={{ maxWidth: 640, height: 480, padding: 24 }}
      >
        <Cropper.Image />
        <Cropper.Mask />
        <Cropper.Area aria-label="Crop area">
          <Cropper.Grid />
          {handles.map((position) => (
            <Cropper.Handle
              key={position}
              position={position}
            />
          ))}
        </Cropper.Area>
      </Cropper.Viewport>
      <Cropper.DialValue
        format={(degrees) =>
          \`\${Math.sign(degrees) * Math.round(Math.abs(degrees))}°\`
        }
      />
      <Cropper.Dial
        aria-label="Straighten"
        style={{ maxWidth: 361 }}
      >
        <Cropper.DialTicks />
      </Cropper.Dial>
      <Cropper.Zoom aria-label="Zoom" style={track}>
        <Cropper.ZoomThumb style={thumb} />
      </Cropper.Zoom>
      <Cropper.AspectGroup aria-label="Aspect ratio">
        {aspects.map((aspect) => (
          <Cropper.AspectItem
            key={aspect.label}
            value={aspect.value}
          >
            {aspect.label}
          </Cropper.AspectItem>
        ))}
      </Cropper.AspectGroup>
      <Cropper.Orientation>orientation</Cropper.Orientation>
      <Cropper.Rotate>rotate</Cropper.Rotate>
      <Cropper.Flip>flip</Cropper.Flip>
      <Cropper.Reset>reset</Cropper.Reset>
      <Cropper.Instructions>
        {instructions}
      </Cropper.Instructions>
      <Cropper.Announcer announce={announce} />
      <button
        type="button"
        disabled={!ready}
        aria-disabled={saving}
        onClick={save}
      >
        export
      </button>
      {failed && <p role="alert">this photo does not open.</p>}
      {exportFailed && (
        <p role="alert">this crop did not save. try again.</p>
      )}
    </Cropper.Root>
  );
};",
    "<span class=s>"use client"</span><span class=p>;</span>

<span class=k>import </span><span class=p>{</span> exportCrop <span class=p>} </span><span class=k>from </span><span class=s>"@zriz/core/dom"</span><span class=p>;</span>
<span class=k>import type </span><span class=p>{</span>
  ChangeReason<span class=p>,</span>
  CommitDetails<span class=p>,</span>
  Cropper <span class=k>as</span> CropperApi<span class=p>,</span>
  CropValue<span class=p>,</span>
<span class=p>} </span><span class=k>from </span><span class=s>"@zriz/react"</span><span class=p>;</span>
<span class=k>import </span><span class=p>* </span><span class=k>as</span> Cropper <span class=k>from </span><span class=s>"@zriz/react/cropper"</span><span class=p>;</span>
<span class=k>import </span><span class=s>"@zriz/react/styles.css"</span><span class=p>;</span>
<span class=k>import </span><span class=p>{</span> useEffect<span class=p>,</span> useRef<span class=p>,</span> useState <span class=p>} </span><span class=k>from </span><span class=s>"react"</span><span class=p>;</span>
<span class=k>import </span><span class=s>"./forced-colors.css"</span><span class=p>;</span>

<span class=k>const</span> handles <span class=p>= [</span>
  <span class=s>"top-left"</span><span class=p>,</span>
  <span class=s>"top"</span><span class=p>,</span>
  <span class=s>"top-right"</span><span class=p>,</span>
  <span class=s>"right"</span><span class=p>,</span>
  <span class=s>"bottom-right"</span><span class=p>,</span>
  <span class=s>"bottom"</span><span class=p>,</span>
  <span class=s>"bottom-left"</span><span class=p>,</span>
  <span class=s>"left"</span><span class=p>,</span>
<span class=p>] </span><span class=k>as const</span><span class=p>;</span>

<span class=k>const</span> track <span class=p>= {</span>
  width<span class=p>: </span><span class=n>200</span><span class=p>,</span>
  height<span class=p>: </span><span class=n>24</span><span class=p>,</span>
  backgroundImage<span class=p>:</span>
    <span class=s>"linear-gradient(currentColor, currentColor)"</span><span class=p>,</span>
  backgroundSize<span class=p>: </span><span class=s>"100% 2px"</span><span class=p>,</span>
  backgroundPosition<span class=p>: </span><span class=s>"center"</span><span class=p>,</span>
  backgroundRepeat<span class=p>: </span><span class=s>"no-repeat"</span><span class=p>,</span>
<span class=p>};</span>

<span class=k>const</span> thumb <span class=p>= {</span>
  top<span class=p>: </span><span class=n>4</span><span class=p>,</span>
  width<span class=p>: </span><span class=n>16</span><span class=p>,</span>
  height<span class=p>: </span><span class=n>16</span><span class=p>,</span>
  borderRadius<span class=p>: </span><span class=n>8</span><span class=p>,</span>
  background<span class=p>: </span><span class=s>"currentColor"</span><span class=p>,</span>
  translate<span class=p>: </span><span class=s>"-50%"</span><span class=p>,</span>
<span class=p>};</span>

<span class=k>const</span> aspects <span class=p>= [</span>
  <span class=p>{</span> label<span class=p>: </span><span class=s>"free"</span><span class=p>,</span> value<span class=p>: </span><span class=s>"free" </span><span class=p>},</span>
  <span class=p>{</span> label<span class=p>: </span><span class=s>"original"</span><span class=p>,</span> value<span class=p>: </span><span class=s>"original" </span><span class=p>},</span>
  <span class=p>{</span> label<span class=p>: </span><span class=s>"square"</span><span class=p>,</span> value<span class=p>: </span><span class=n>1 </span><span class=p>},</span>
  <span class=p>{</span> label<span class=p>: </span><span class=s>"4:5"</span><span class=p>,</span> value<span class=p>: </span><span class=n>4 </span><span class=p>/ </span><span class=n>5 </span><span class=p>},</span>
  <span class=p>{</span> label<span class=p>: </span><span class=s>"16:9"</span><span class=p>,</span> value<span class=p>: </span><span class=n>16 </span><span class=p>/ </span><span class=n>9 </span><span class=p>},</span>
<span class=p>] </span><span class=k>as const</span><span class=p>;</span>

<span class=k>const</span> spoken<span class=p>:</span> Partial<span class=p>&lt;</span>Record<span class=p>&lt;</span>ChangeReason<span class=p>,</span> string<span class=p>&gt;&gt; = {</span>
  <span class=s>"</span>rotate-90<span class=s>"</span><span class=p>: </span><span class=s>"Turned 90 degrees"</span><span class=p>,</span>
  flip<span class=p>: </span><span class=s>"Flipped"</span><span class=p>,</span>
  orientation<span class=p>: </span><span class=s>"Orientation swapped"</span><span class=p>,</span>
  reset<span class=p>: </span><span class=s>"Crop reset"</span><span class=p>,</span>
<span class=p>};</span>

<span class=k>const </span><span class=t>announce </span><span class=p>= (</span>_<span class=p>:</span> CropValue<span class=p>,</span> details<span class=p>:</span> CommitDetails<span class=p>) =&gt;</span>
  spoken<span class=p>[</span>details<span class=p>.</span>reason<span class=p>] ?? </span><span class=k>null</span><span class=p>;</span>

<span class=k>const</span> instructions <span class=p>= [</span>
  <span class=s>"Drag the photo to move it."</span><span class=p>,</span>
  <span class=s>"Arrows move the crop. Alt and arrows resize it."</span><span class=p>,</span>
  <span class=s>"Plus and minus zoom, and 0 resets."</span><span class=p>,</span>
<span class=p>].</span><span class=t>join</span><span class=p>(</span><span class=s>" "</span><span class=p>);</span>

<span class=k>type</span> Props <span class=p>= {</span> src<span class=p>:</span> string<span class=p>;</span> onSave<span class=p>: (</span>jpeg<span class=p>:</span> Blob<span class=p>) =&gt;</span> void <span class=p>};</span>

<span class=k>export const </span><span class=t>Editor </span><span class=p>= ({</span> src<span class=p>,</span> onSave <span class=p>}:</span> Props<span class=p>) =&gt; {</span>
  <span class=k>const</span> actions <span class=p>= </span><span class=t>useRef</span><span class=p>&lt;</span>CropperApi<span class=p>&gt;(</span><span class=k>null</span><span class=p>);</span>
  <span class=k>const</span> running <span class=p>= </span><span class=t>useRef</span><span class=p>&lt;</span>AbortController <span class=p>|</span> null<span class=p>&gt;(</span><span class=k>null</span><span class=p>);</span>
  <span class=k>const </span><span class=p>[</span>saving<span class=p>,</span> setSaving<span class=p>] = </span><span class=t>useState</span><span class=p>(</span><span class=n>false</span><span class=p>);</span>
  <span class=k>const </span><span class=p>[</span>ready<span class=p>,</span> setReady<span class=p>] = </span><span class=t>useState</span><span class=p>(</span><span class=n>false</span><span class=p>);</span>
  <span class=k>const </span><span class=p>[</span>failed<span class=p>,</span> setFailed<span class=p>] = </span><span class=t>useState</span><span class=p>(</span><span class=n>false</span><span class=p>);</span>
  <span class=k>const </span><span class=p>[</span>exportFailed<span class=p>,</span> setExportFailed<span class=p>] = </span><span class=t>useState</span><span class=p>(</span><span class=n>false</span><span class=p>);</span>
  <span class=k>const </span><span class=p>[</span>shown<span class=p>,</span> setShown<span class=p>] = </span><span class=t>useState</span><span class=p>(</span>src<span class=p>);</span>

  <span class=k>if </span><span class=p>(</span>shown <span class=p>!==</span> src<span class=p>) {</span>
    <span class=t>setShown</span><span class=p>(</span>src<span class=p>);</span>
    <span class=t>setReady</span><span class=p>(</span><span class=n>false</span><span class=p>);</span>
    <span class=t>setFailed</span><span class=p>(</span><span class=n>false</span><span class=p>);</span>
    <span class=t>setExportFailed</span><span class=p>(</span><span class=n>false</span><span class=p>);</span>
  <span class=p>}</span>

  <span class=t>useEffect</span><span class=p>(() =&gt; () =&gt;</span> running<span class=p>.</span>current<span class=p>?.</span><span class=t>abort</span><span class=p>(), [</span>src<span class=p>]);</span>

  <span class=k>const </span><span class=t>save </span><span class=p>= </span><span class=k>async </span><span class=p>() =&gt; {</span>
    <span class=k>if </span><span class=p>(!</span>actions<span class=p>.</span>current <span class=p>||</span> running<span class=p>.</span>current<span class=p>) </span><span class=k>return</span><span class=p>;</span>
    <span class=k>const</span> controller <span class=p>= </span><span class=k>new </span><span class=t>AbortController</span><span class=p>();</span>

    running<span class=p>.</span>current <span class=p>=</span> controller<span class=p>;</span>
    <span class=t>setSaving</span><span class=p>(</span><span class=n>true</span><span class=p>);</span>
    <span class=t>setExportFailed</span><span class=p>(</span><span class=n>false</span><span class=p>);</span>

    <span class=k>try </span><span class=p>{</span>
      <span class=k>const </span><span class=p>{</span> blob <span class=p>} = </span><span class=k>await </span><span class=t>exportCrop</span><span class=p>(</span>actions<span class=p>.</span>current<span class=p>, {</span>
        signal<span class=p>:</span> controller<span class=p>.</span>signal<span class=p>,</span>
      <span class=p>});</span>

      <span class=t>onSave</span><span class=p>(</span>blob<span class=p>);</span>
    <span class=p>} </span><span class=k>catch </span><span class=p>{</span>
      <span class=t>setExportFailed</span><span class=p>(!</span>controller<span class=p>.</span>signal<span class=p>.</span>aborted<span class=p>);</span>
    <span class=p>} </span><span class=k>finally </span><span class=p>{</span>
      running<span class=p>.</span>current <span class=p>= </span><span class=k>null</span><span class=p>;</span>
      <span class=t>setSaving</span><span class=p>(</span><span class=n>false</span><span class=p>);</span>
    <span class=p>}</span>
  <span class=p>};</span>

  <span class=k>return </span><span class=p>(</span>
    <span class=p>&lt;</span><span class=t>Cropper.Root</span>
      <span class=a>key</span><span class=p>={</span>src<span class=p>}</span>
      <span class=a>actionsRef</span><span class=p>={</span>actions<span class=p>}</span>
      <span class=a>src</span><span class=p>={</span>src<span class=p>}</span>
      <span class=a>onLoad</span><span class=p>={() =&gt; </span><span class=t>setReady</span><span class=p>(</span><span class=n>true</span><span class=p>)}</span>
      <span class=a>onError</span><span class=p>={() =&gt; </span><span class=t>setFailed</span><span class=p>(</span><span class=n>true</span><span class=p>)}</span>
    <span class=p>&gt;</span>
      <span class=p>&lt;</span><span class=t>Cropper.Viewport</span>
        <span class=a>style</span><span class=p>={{</span> maxWidth<span class=p>: </span><span class=n>640</span><span class=p>,</span> height<span class=p>: </span><span class=n>480</span><span class=p>,</span> padding<span class=p>: </span><span class=n>24 </span><span class=p>}}</span>
      <span class=p>&gt;</span>
        <span class=p>&lt;</span><span class=t>Cropper.Image </span><span class=p>/&gt;</span>
        <span class=p>&lt;</span><span class=t>Cropper.Mask </span><span class=p>/&gt;</span>
        <span class=p>&lt;</span><span class=t>Cropper.Area </span><span class=a>aria-label</span><span class=p>="</span><span class=s>Crop area</span><span class=p>"&gt;</span>
          <span class=p>&lt;</span><span class=t>Cropper.Grid </span><span class=p>/&gt;</span>
          <span class=p>{</span>handles<span class=p>.</span><span class=t>map</span><span class=p>((</span>position<span class=p>) =&gt; (</span>
            <span class=p>&lt;</span><span class=t>Cropper.Handle</span>
              <span class=a>key</span><span class=p>={</span>position<span class=p>}</span>
              <span class=a>position</span><span class=p>={</span>position<span class=p>}</span>
            <span class=p>/&gt;</span>
          <span class=p>))}</span>
        <span class=p>&lt;/</span><span class=t>Cropper.Area</span><span class=p>&gt;</span>
      <span class=p>&lt;/</span><span class=t>Cropper.Viewport</span><span class=p>&gt;</span>
      <span class=p>&lt;</span><span class=t>Cropper.DialValue</span>
        <span class=a>format</span><span class=p>={(</span>degrees<span class=p>) =&gt;</span>
          <span class=s>\`</span><span class=p>\${</span>Math<span class=p>.</span><span class=t>sign</span><span class=p>(</span>degrees<span class=p>) *</span> Math<span class=p>.</span><span class=t>round</span><span class=p>(</span>Math<span class=p>.</span><span class=t>abs</span><span class=p>(</span>degrees<span class=p>))}</span><span class=s>°\`</span>
        <span class=p>}</span>
      <span class=p>/&gt;</span>
      <span class=p>&lt;</span><span class=t>Cropper.Dial</span>
        <span class=a>aria-label</span><span class=p>="</span><span class=s>Straighten</span><span class=p>"</span>
        <span class=a>style</span><span class=p>={{</span> maxWidth<span class=p>: </span><span class=n>361 </span><span class=p>}}</span>
      <span class=p>&gt;</span>
        <span class=p>&lt;</span><span class=t>Cropper.DialTicks </span><span class=p>/&gt;</span>
      <span class=p>&lt;/</span><span class=t>Cropper.Dial</span><span class=p>&gt;</span>
      <span class=p>&lt;</span><span class=t>Cropper.Zoom </span><span class=a>aria-label</span><span class=p>="</span><span class=s>Zoom</span><span class=p>" </span><span class=a>style</span><span class=p>={</span>track<span class=p>}&gt;</span>
        <span class=p>&lt;</span><span class=t>Cropper.ZoomThumb </span><span class=a>style</span><span class=p>={</span>thumb<span class=p>} /&gt;</span>
      <span class=p>&lt;/</span><span class=t>Cropper.Zoom</span><span class=p>&gt;</span>
      <span class=p>&lt;</span><span class=t>Cropper.AspectGroup </span><span class=a>aria-label</span><span class=p>="</span><span class=s>Aspect ratio</span><span class=p>"&gt;</span>
        <span class=p>{</span>aspects<span class=p>.</span><span class=t>map</span><span class=p>((</span>aspect<span class=p>) =&gt; (</span>
          <span class=p>&lt;</span><span class=t>Cropper.AspectItem</span>
            <span class=a>key</span><span class=p>={</span>aspect<span class=p>.</span>label<span class=p>}</span>
            <span class=a>value</span><span class=p>={</span>aspect<span class=p>.</span>value<span class=p>}</span>
          <span class=p>&gt;</span>
            <span class=p>{</span>aspect<span class=p>.</span>label<span class=p>}</span>
          <span class=p>&lt;/</span><span class=t>Cropper.AspectItem</span><span class=p>&gt;</span>
        <span class=p>))}</span>
      <span class=p>&lt;/</span><span class=t>Cropper.AspectGroup</span><span class=p>&gt;</span>
      <span class=p>&lt;</span><span class=t>Cropper.Orientation</span><span class=p>&gt;</span>orientation<span class=p>&lt;/</span><span class=t>Cropper.Orientation</span><span class=p>&gt;</span>
      <span class=p>&lt;</span><span class=t>Cropper.Rotate</span><span class=p>&gt;</span>rotate<span class=p>&lt;/</span><span class=t>Cropper.Rotate</span><span class=p>&gt;</span>
      <span class=p>&lt;</span><span class=t>Cropper.Flip</span><span class=p>&gt;</span>flip<span class=p>&lt;/</span><span class=t>Cropper.Flip</span><span class=p>&gt;</span>
      <span class=p>&lt;</span><span class=t>Cropper.Reset</span><span class=p>&gt;</span>reset<span class=p>&lt;/</span><span class=t>Cropper.Reset</span><span class=p>&gt;</span>
      <span class=p>&lt;</span><span class=t>Cropper.Instructions</span><span class=p>&gt;</span>
        <span class=p>{</span>instructions<span class=p>}</span>
      <span class=p>&lt;/</span><span class=t>Cropper.Instructions</span><span class=p>&gt;</span>
      <span class=p>&lt;</span><span class=t>Cropper.Announcer </span><span class=a>announce</span><span class=p>={</span>announce<span class=p>} /&gt;</span>
      <span class=p>&lt;</span><span class=t>button</span>
        <span class=a>type</span><span class=p>="</span><span class=s>button</span><span class=p>"</span>
        <span class=a>disabled</span><span class=p>={!</span>ready<span class=p>}</span>
        <span class=a>aria-disabled</span><span class=p>={</span>saving<span class=p>}</span>
        <span class=a>onClick</span><span class=p>={</span>save<span class=p>}</span>
      <span class=p>&gt;</span>
        export
      <span class=p>&lt;/</span><span class=t>button</span><span class=p>&gt;</span>
      <span class=p>{</span>failed <span class=p>&amp;&amp; &lt;</span><span class=t>p </span><span class=a>role</span><span class=p>=</span><span class=s>"alert"</span><span class=p>&gt;</span>this photo does not open.<span class=p>&lt;/</span><span class=t>p</span><span class=p>&gt;}</span>
      <span class=p>{</span>exportFailed <span class=p>&amp;&amp; (</span>
        <span class=p>&lt;</span><span class=t>p </span><span class=a>role</span><span class=p>=</span><span class=s>"alert"</span><span class=p>&gt;</span>this crop did not save. try again.<span class=p>&lt;/</span><span class=t>p</span><span class=p>&gt;</span>
      <span class=p>)}</span>
    <span class=p>&lt;/</span><span class=t>Cropper.Root</span><span class=p>&gt;</span>
  <span class=p>);</span>
<span class=p>};</span>",
