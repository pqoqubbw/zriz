<span class=k>export const </span><span class=t>save </span><span class=p>= </span><span class=k>async </span><span class=p>(</span>
  cropper<span class=p>:</span> Cropper<span class=p>,</span>
  signal<span class=p>?:</span> AbortSignal
<span class=p>) =&gt; {</span>
  <span class=k>try </span><span class=p>{</span>
    <span class=k>const </span><span class=p>{</span> blob <span class=p>} = </span><span class=k>await </span><span class=t>exportCrop</span><span class=p>(</span>cropper<span class=p>, {</span> signal <span class=p>});</span>
    <span class=k>return</span> blob<span class=p>;</span>
  <span class=p>} </span><span class=k>catch </span><span class=p>(</span>error<span class=p>) {</span>
