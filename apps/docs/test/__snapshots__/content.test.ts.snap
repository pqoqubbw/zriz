  <span class=p>}</span>

  <span class=k>if </span><span class=p>(</span>meta<span class=p>.</span>format <span class=p>=== </span><span class=s>"webp" </span><span class=p>&amp;&amp; (</span>meta<span class=p>.</span>orientation <span class=p>?? </span><span class=n>1</span><span class=p>) &gt; </span><span class=n>1</span><span class=p>) {</span>
