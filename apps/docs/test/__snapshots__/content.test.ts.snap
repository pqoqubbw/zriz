      <span class=p>});</span>

      <span class=k>if </span><span class=p>(</span>response<span class=p>.</span>ok<span class=p>) {</span>
        <span class=k>const</span> blob <span class=p>= </span><span class=k>await</span> response<span class=p>.</span><span class=t>blob</span><span class=p>();</span>

