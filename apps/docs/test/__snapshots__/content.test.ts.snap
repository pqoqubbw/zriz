          <span class=t>setResult</span><span class=p>(</span>URL<span class=p>.</span><span class=t>createObjectURL</span><span class=p>(</span>blob<span class=p>));</span>
        <span class=p>}</span>
      <span class=p>} </span><span class=k>else </span><span class=p>{</span>
