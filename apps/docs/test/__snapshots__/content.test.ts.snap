  bindPhoto<span class=p>,</span>
  bindState<span class=p>,</span>
  bindViewport<span class=p>,</span>
  loadImage<span class=p>,</span>
<span class=p>} </span><span class=k>from </span><span class=s>"@zriz/core/dom"</span><span class=p>;</span>
