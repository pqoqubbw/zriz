        <span class=a>key</span><span class=p>={</span>picks<span class=p>}</span>
        <span class=a>actionsRef</span><span class=p>={</span>actions<span class=p>}</span>
        <span class=a>maxZoom</span><span class=p>={</span>MAX_ZOOM<span class=p>}</span>
        <span class=a>minSize</span><span class=p>={</span>MIN_SIZE<span class=p>}</span>
        <span class=a>src</span><span class=p>={</span>file<span class=p>}</span>
        <span class=a>svg</span><span class=p>={</span><span class=n>false</span><span class=p>}</span>
        <span class=a>onLoad</span><span class=p>={() =&gt; </span><span class=t>setReady</span><span class=p>(</span><span class=n>true</span><span class=p>)}</span>
