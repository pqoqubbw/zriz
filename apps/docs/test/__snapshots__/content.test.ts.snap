  [
    "loading-images",
    "loading-images/heic.tsx",
    ""use client";

import type { Cropper as CropperApi } from "@zriz/react";
import * as Cropper from "@zriz/react/cropper";
import { useRef, useState } from "react";
import { open } from "./decoder";

type Props = { onSave: (cropper: CropperApi) => void };

export const Heic = ({ onSave }: Props) => {
  const cropper = useRef<CropperApi>(null);
  const last = useRef<AbortController | null>(null);
  const [ready, setReady] = useState(false);
  const [failed, setFailed] = useState(false);

  return (
    <>
      <input
        type="file"
        accept="image/*,.heic"
        onChange={(event) => {
          const file = event.target.files?.[0];
          if (!file || !cropper.current) return;
          last.current?.abort();
          const controller = new AbortController();
          last.current = controller;
          setReady(false);
          setFailed(false);
          open(cropper.current, file, controller.signal).then(
            () => setReady(true),
            () => {
              if (!controller.signal.aborted) setFailed(true);
            }
          );
        }}
      />
      <Cropper.Root actionsRef={cropper}>
        <Cropper.Viewport style={{ width: 480, height: 360 }}>
          <Cropper.Image />
          <Cropper.Mask />
          <Cropper.Area aria-label="Crop area" />
        </Cropper.Viewport>
      </Cropper.Root>
      <button
        type="button"
        disabled={!ready}
        onClick={() =>
          cropper.current && onSave(cropper.current)
        }
      >
        save
      </button>
      {failed && (
        <p role="alert">this photo does not open here.</p>
      )}
    </>
  );
};",
    "<span class=s>"use client"</span><span class=p>;</span>

<span class=k>import type </span><span class=p>{</span> Cropper <span class=k>as</span> CropperApi <span class=p>} </span><span class=k>from </span><span class=s>"@zriz/react"</span><span class=p>;</span>
<span class=k>import </span><span class=p>* </span><span class=k>as</span> Cropper <span class=k>from </span><span class=s>"@zriz/react/cropper"</span><span class=p>;</span>
<span class=k>import </span><span class=p>{</span> useRef<span class=p>,</span> useState <span class=p>} </span><span class=k>from </span><span class=s>"react"</span><span class=p>;</span>
<span class=k>import </span><span class=p>{</span> open <span class=p>} </span><span class=k>from </span><span class=s>"./decoder"</span><span class=p>;</span>

<span class=k>type</span> Props <span class=p>= {</span> onSave<span class=p>: (</span>cropper<span class=p>:</span> CropperApi<span class=p>) =&gt;</span> void <span class=p>};</span>

<span class=k>export const </span><span class=t>Heic </span><span class=p>= ({</span> onSave <span class=p>}:</span> Props<span class=p>) =&gt; {</span>
  <span class=k>const</span> cropper <span class=p>= </span><span class=t>useRef</span><span class=p>&lt;</span>CropperApi<span class=p>&gt;(</span><span class=k>null</span><span class=p>);</span>
  <span class=k>const</span> last <span class=p>= </span><span class=t>useRef</span><span class=p>&lt;</span>AbortController <span class=p>|</span> null<span class=p>&gt;(</span><span class=k>null</span><span class=p>);</span>
  <span class=k>const </span><span class=p>[</span>ready<span class=p>,</span> setReady<span class=p>] = </span><span class=t>useState</span><span class=p>(</span><span class=n>false</span><span class=p>);</span>
  <span class=k>const </span><span class=p>[</span>failed<span class=p>,</span> setFailed<span class=p>] = </span><span class=t>useState</span><span class=p>(</span><span class=n>false</span><span class=p>);</span>

  <span class=k>return </span><span class=p>(</span>
    <span class=p>&lt;&gt;</span>
      <span class=p>&lt;</span><span class=t>input</span>
        <span class=a>type</span><span class=p>="</span><span class=s>file</span><span class=p>"</span>
        <span class=a>accept</span><span class=p>="</span><span class=s>image/*,.heic</span><span class=p>"</span>
        <span class=a>onChange</span><span class=p>={(</span>event<span class=p>) =&gt; {</span>
          <span class=k>const</span> file <span class=p>=</span> event<span class=p>.</span>target<span class=p>.</span>files<span class=p>?.[</span><span class=n>0</span><span class=p>];</span>
          <span class=k>if </span><span class=p>(!</span>file <span class=p>|| !</span>cropper<span class=p>.</span>current<span class=p>) </span><span class=k>return</span><span class=p>;</span>
          last<span class=p>.</span>current<span class=p>?.</span><span class=t>abort</span><span class=p>();</span>
          <span class=k>const</span> controller <span class=p>= </span><span class=k>new </span><span class=t>AbortController</span><span class=p>();</span>
          last<span class=p>.</span>current <span class=p>=</span> controller<span class=p>;</span>
          <span class=t>setReady</span><span class=p>(</span><span class=n>false</span><span class=p>);</span>
          <span class=t>setFailed</span><span class=p>(</span><span class=n>false</span><span class=p>);</span>
          <span class=t>open</span><span class=p>(</span>cropper<span class=p>.</span>current<span class=p>,</span> file<span class=p>,</span> controller<span class=p>.</span>signal<span class=p>).</span><span class=t>then</span><span class=p>(</span>
            <span class=p>() =&gt; </span><span class=t>setReady</span><span class=p>(</span><span class=n>true</span><span class=p>),</span>
            <span class=p>() =&gt; {</span>
              <span class=k>if </span><span class=p>(!</span>controller<span class=p>.</span>signal<span class=p>.</span>aborted<span class=p>) </span><span class=t>setFailed</span><span class=p>(</span><span class=n>true</span><span class=p>);</span>
            <span class=p>}</span>
          <span class=p>);</span>
        <span class=p>}}</span>
      <span class=p>/&gt;</span>
