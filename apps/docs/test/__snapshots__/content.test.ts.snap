    <span class=p>}</span>
  <span class=p>};</span>

  <span class=k>return </span><span class=p>(</span>
    <span class=p>&lt;&gt;</span>
      <span class=p>&lt;</span><span class=t>input</span>
        <span class=a>type</span><span class=p>="</span><span class=s>file</span><span class=p>"</span>
        <span class=a>accept</span><span class=p>="</span><span class=s>image/*</span><span class=p>"</span>
