    <span class=t>setSaved</span><span class=p>({</span> id<span class=p>,</span> value<span class=p>: </span><span class=t>parse</span><span class=p>(</span>localStorage<span class=p>.</span><span class=t>getItem</span><span class=p>(</span>key<span class=p>)) });</span>
  <span class=p>}, [</span>id<span class=p>,</span> key<span class=p>]);</span>

  <span class=k>if </span><span class=p>(</span>saved<span class=p>?.</span>id <span class=p>!==</span> id<span class=p>) </span><span class=k>return null</span><span class=p>;</span>

  <span class=k>return </span><span class=p>(</span>
