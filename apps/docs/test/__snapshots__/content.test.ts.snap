  [
    "avatar",
    "avatar/avatar-picker.tsx",
    ""use client";

import { exportCrop } from "@zriz/core/dom";
import type { Cropper as CropperApi } from "@zriz/react";
import * as Cropper from "@zriz/react/cropper";
import "@zriz/react/styles.css";
import { useEffect, useRef, useState } from "react";

type Props = { onSave: (png: Blob) => void };
type Status = "empty" | "ready" | "failed";

const unreadable =
  "this photo does not open. pick a jpeg, png or webp.";
const unsaved = "this crop did not save. try again.";

export const AvatarPicker = ({ onSave }: Props) => {
  const [file, setFile] = useState<File | null>(null);
  const [status, setStatus] = useState<Status>("empty");
  const [saveFailed, setSaveFailed] = useState(false);
  const [picks, setPicks] = useState(0);
  const [saving, setSaving] = useState(false);
  const actions = useRef<CropperApi>(null);
  const running = useRef<AbortController | null>(null);

  useEffect(() => () => running.current?.abort(), [picks]);

  const save = async () => {
    if (!actions.current || running.current) return;
    const controller = new AbortController();

    running.current = controller;
    setSaving(true);

    try {
      const { blob } = await exportCrop(actions.current, {
        maxSize: { width: 512, height: 512 },
        signal: controller.signal,
      });

      setSaveFailed(false);
      onSave(blob);
    } catch {
      setSaveFailed(!controller.signal.aborted);
    } finally {
      running.current = null;
      setSaving(false);
    }
  };

  return (
    <>
      <input
        aria-label="Choose a photo"
        type="file"
        accept="image/*"
        onClick={(event) => {
          event.currentTarget.value = "";
        }}
        onChange={(event) => {
          setStatus("empty");
          setSaveFailed(false);
          setPicks((count) => count + 1);
          setFile(event.target.files?.[0] ?? null);
        }}
      />
      <Cropper.Root
        key={picks}
        actionsRef={actions}
        src={file}
        svg={false}
        shape="circle"
        minSize={{ width: 512, height: 512 }}
        onLoad={() => setStatus("ready")}
        onError={() => setStatus("failed")}
      >
        <Cropper.Viewport
          wheel="zoom"
          style={{ width: 320, height: 320 }}
        >
          <Cropper.Image />
          <Cropper.Mask />
          <Cropper.Area aria-label="Crop area" />
        </Cropper.Viewport>
      </Cropper.Root>
      {status === "failed" && <p role="alert">{unreadable}</p>}
      {saveFailed && <p role="alert">{unsaved}</p>}
      <button
        type="button"
        disabled={status !== "ready"}
        aria-disabled={saving}
        onClick={save}
      >
        save
      </button>
    </>
  );
};",
    "<span class=s>"use client"</span><span class=p>;</span>

<span class=k>import </span><span class=p>{</span> exportCrop <span class=p>} </span><span class=k>from </span><span class=s>"@zriz/core/dom"</span><span class=p>;</span>
<span class=k>import type </span><span class=p>{</span> Cropper <span class=k>as</span> CropperApi <span class=p>} </span><span class=k>from </span><span class=s>"@zriz/react"</span><span class=p>;</span>
<span class=k>import </span><span class=p>* </span><span class=k>as</span> Cropper <span class=k>from </span><span class=s>"@zriz/react/cropper"</span><span class=p>;</span>
<span class=k>import </span><span class=s>"@zriz/react/styles.css"</span><span class=p>;</span>
<span class=k>import </span><span class=p>{</span> useEffect<span class=p>,</span> useRef<span class=p>,</span> useState <span class=p>} </span><span class=k>from </span><span class=s>"react"</span><span class=p>;</span>

<span class=k>type</span> Props <span class=p>= {</span> onSave<span class=p>: (</span>png<span class=p>:</span> Blob<span class=p>) =&gt;</span> void <span class=p>};</span>
<span class=k>type</span> Status <span class=p>= </span><span class=s>"</span>empty<span class=s>" </span><span class=p>| </span><span class=s>"</span>ready<span class=s>" </span><span class=p>| </span><span class=s>"</span>failed<span class=s>"</span><span class=p>;</span>

<span class=k>const</span> unreadable <span class=p>=</span>
  <span class=s>"this photo does not open. pick a jpeg, png or webp."</span><span class=p>;</span>
<span class=k>const</span> unsaved <span class=p>= </span><span class=s>"this crop did not save. try again."</span><span class=p>;</span>

<span class=k>export const </span><span class=t>AvatarPicker </span><span class=p>= ({</span> onSave <span class=p>}:</span> Props<span class=p>) =&gt; {</span>
  <span class=k>const </span><span class=p>[</span>file<span class=p>,</span> setFile<span class=p>] = </span><span class=t>useState</span><span class=p>&lt;</span>File <span class=p>|</span> null<span class=p>&gt;(</span><span class=k>null</span><span class=p>);</span>
  <span class=k>const </span><span class=p>[</span>status<span class=p>,</span> setStatus<span class=p>] = </span><span class=t>useState</span><span class=p>&lt;</span>Status<span class=p>&gt;(</span><span class=s>"empty"</span><span class=p>);</span>
  <span class=k>const </span><span class=p>[</span>saveFailed<span class=p>,</span> setSaveFailed<span class=p>] = </span><span class=t>useState</span><span class=p>(</span><span class=n>false</span><span class=p>);</span>
  <span class=k>const </span><span class=p>[</span>picks<span class=p>,</span> setPicks<span class=p>] = </span><span class=t>useState</span><span class=p>(</span><span class=n>0</span><span class=p>);</span>
  <span class=k>const </span><span class=p>[</span>saving<span class=p>,</span> setSaving<span class=p>] = </span><span class=t>useState</span><span class=p>(</span><span class=n>false</span><span class=p>);</span>
  <span class=k>const</span> actions <span class=p>= </span><span class=t>useRef</span><span class=p>&lt;</span>CropperApi<span class=p>&gt;(</span><span class=k>null</span><span class=p>);</span>
  <span class=k>const</span> running <span class=p>= </span><span class=t>useRef</span><span class=p>&lt;</span>AbortController <span class=p>|</span> null<span class=p>&gt;(</span><span class=k>null</span><span class=p>);</span>

  <span class=t>useEffect</span><span class=p>(() =&gt; () =&gt;</span> running<span class=p>.</span>current<span class=p>?.</span><span class=t>abort</span><span class=p>(), [</span>picks<span class=p>]);</span>

  <span class=k>const </span><span class=t>save </span><span class=p>= </span><span class=k>async </span><span class=p>() =&gt; {</span>
    <span class=k>if </span><span class=p>(!</span>actions<span class=p>.</span>current <span class=p>||</span> running<span class=p>.</span>current<span class=p>) </span><span class=k>return</span><span class=p>;</span>
    <span class=k>const</span> controller <span class=p>= </span><span class=k>new </span><span class=t>AbortController</span><span class=p>();</span>

    running<span class=p>.</span>current <span class=p>=</span> controller<span class=p>;</span>
    <span class=t>setSaving</span><span class=p>(</span><span class=n>true</span><span class=p>);</span>

    <span class=k>try </span><span class=p>{</span>
      <span class=k>const </span><span class=p>{</span> blob <span class=p>} = </span><span class=k>await </span><span class=t>exportCrop</span><span class=p>(</span>actions<span class=p>.</span>current<span class=p>, {</span>
        maxSize<span class=p>: {</span> width<span class=p>: </span><span class=n>512</span><span class=p>,</span> height<span class=p>: </span><span class=n>512 </span><span class=p>},</span>
        signal<span class=p>:</span> controller<span class=p>.</span>signal<span class=p>,</span>
      <span class=p>});</span>

      <span class=t>setSaveFailed</span><span class=p>(</span><span class=n>false</span><span class=p>);</span>
      <span class=t>onSave</span><span class=p>(</span>blob<span class=p>);</span>
    <span class=p>} </span><span class=k>catch </span><span class=p>{</span>
      <span class=t>setSaveFailed</span><span class=p>(!</span>controller<span class=p>.</span>signal<span class=p>.</span>aborted<span class=p>);</span>
    <span class=p>} </span><span class=k>finally </span><span class=p>{</span>
      running<span class=p>.</span>current <span class=p>= </span><span class=k>null</span><span class=p>;</span>
      <span class=t>setSaving</span><span class=p>(</span><span class=n>false</span><span class=p>);</span>
    <span class=p>}</span>
  <span class=p>};</span>

  <span class=k>return </span><span class=p>(</span>
    <span class=p>&lt;&gt;</span>
      <span class=p>&lt;</span><span class=t>input</span>
        <span class=a>aria-label</span><span class=p>="</span><span class=s>Choose a photo</span><span class=p>"</span>
        <span class=a>type</span><span class=p>="</span><span class=s>file</span><span class=p>"</span>
        <span class=a>accept</span><span class=p>="</span><span class=s>image/*</span><span class=p>"</span>
        <span class=a>onClick</span><span class=p>={(</span>event<span class=p>) =&gt; {</span>
          event<span class=p>.</span>currentTarget<span class=p>.</span>value <span class=p>= </span><span class=s>""</span><span class=p>;</span>
        <span class=p>}}</span>
        <span class=a>onChange</span><span class=p>={(</span>event<span class=p>) =&gt; {</span>
          <span class=t>setStatus</span><span class=p>(</span><span class=s>"empty"</span><span class=p>);</span>
          <span class=t>setSaveFailed</span><span class=p>(</span><span class=n>false</span><span class=p>);</span>
          <span class=t>setPicks</span><span class=p>((</span>count<span class=p>) =&gt;</span> count <span class=p>+ </span><span class=n>1</span><span class=p>);</span>
          <span class=t>setFile</span><span class=p>(</span>event<span class=p>.</span>target<span class=p>.</span>files<span class=p>?.[</span><span class=n>0</span><span class=p>] ?? </span><span class=k>null</span><span class=p>);</span>
        <span class=p>}}</span>
      <span class=p>/&gt;</span>
      <span class=p>&lt;</span><span class=t>Cropper.Root</span>
        <span class=a>key</span><span class=p>={</span>picks<span class=p>}</span>
        <span class=a>actionsRef</span><span class=p>={</span>actions<span class=p>}</span>
        <span class=a>src</span><span class=p>={</span>file<span class=p>}</span>
        <span class=a>svg</span><span class=p>={</span><span class=n>false</span><span class=p>}</span>
        <span class=a>shape</span><span class=p>="</span><span class=s>circle</span><span class=p>"</span>
        <span class=a>minSize</span><span class=p>={{</span> width<span class=p>: </span><span class=n>512</span><span class=p>,</span> height<span class=p>: </span><span class=n>512 </span><span class=p>}}</span>
        <span class=a>onLoad</span><span class=p>={() =&gt; </span><span class=t>setStatus</span><span class=p>(</span><span class=s>"ready"</span><span class=p>)}</span>
        <span class=a>onError</span><span class=p>={() =&gt; </span><span class=t>setStatus</span><span class=p>(</span><span class=s>"failed"</span><span class=p>)}</span>
      <span class=p>&gt;</span>
        <span class=p>&lt;</span><span class=t>Cropper.Viewport</span>
          <span class=a>wheel</span><span class=p>="</span><span class=s>zoom</span><span class=p>"</span>
          <span class=a>style</span><span class=p>={{</span> width<span class=p>: </span><span class=n>320</span><span class=p>,</span> height<span class=p>: </span><span class=n>320 </span><span class=p>}}</span>
        <span class=p>&gt;</span>
          <span class=p>&lt;</span><span class=t>Cropper.Image </span><span class=p>/&gt;</span>
          <span class=p>&lt;</span><span class=t>Cropper.Mask </span><span class=p>/&gt;</span>
          <span class=p>&lt;</span><span class=t>Cropper.Area </span><span class=a>aria-label</span><span class=p>="</span><span class=s>Crop area</span><span class=p>" /&gt;</span>
        <span class=p>&lt;/</span><span class=t>Cropper.Viewport</span><span class=p>&gt;</span>
      <span class=p>&lt;/</span><span class=t>Cropper.Root</span><span class=p>&gt;</span>
      <span class=p>{</span>status <span class=p>=== </span><span class=s>"failed" </span><span class=p>&amp;&amp; &lt;</span><span class=t>p </span><span class=a>role</span><span class=p>=</span><span class=s>"alert"</span><span class=p>&gt;{</span>unreadable<span class=p>}&lt;/</span><span class=t>p</span><span class=p>&gt;}</span>
      <span class=p>{</span>saveFailed <span class=p>&amp;&amp; &lt;</span><span class=t>p </span><span class=a>role</span><span class=p>=</span><span class=s>"alert"</span><span class=p>&gt;{</span>unsaved<span class=p>}&lt;/</span><span class=t>p</span><span class=p>&gt;}</span>
