<span class=k>const </span><span class=t>onFile </span><span class=p>= </span><span class=k>async </span><span class=p>() =&gt; {</span>
  <span class=k>const</span> file <span class=p>=</span> input<span class=p>.</span>files<span class=p>?.[</span><span class=n>0</span><span class=p>];</span>

