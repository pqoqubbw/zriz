    "loading-images/decoder.ts",
    "import { attachImage, loadImage } from "@zriz/core/dom";
import type { Cropper } from "@zriz/react";

const convert = async (blob: Blob) => {
  const response = await fetch("/api/convert", {
    method: "POST",
    body: blob,
  });
  return await createImageBitmap(await response.blob());
};

export const open = async (
  cropper: Cropper,
  file: File,
  signal: AbortSignal
) => {
  const image = await loadImage(file, {
    timeout: 30_000,
    decode: convert,
    signal,
  });
  attachImage(cropper, image);
};",
    "<span class=k>import </span><span class=p>{</span> attachImage<span class=p>,</span> loadImage <span class=p>} </span><span class=k>from </span><span class=s>"@zriz/core/dom"</span><span class=p>;</span>
<span class=k>import type </span><span class=p>{</span> Cropper <span class=p>} </span><span class=k>from </span><span class=s>"@zriz/react"</span><span class=p>;</span>

<span class=k>const </span><span class=t>convert </span><span class=p>= </span><span class=k>async </span><span class=p>(</span>blob<span class=p>:</span> Blob<span class=p>) =&gt; {</span>
  <span class=k>const</span> response <span class=p>= </span><span class=k>await </span><span class=t>fetch</span><span class=p>(</span><span class=s>"/api/convert"</span><span class=p>, {</span>
    method<span class=p>: </span><span class=s>"POST"</span><span class=p>,</span>
    body<span class=p>:</span> blob<span class=p>,</span>
  <span class=p>});</span>
  <span class=k>return await </span><span class=t>createImageBitmap</span><span class=p>(</span><span class=k>await</span> response<span class=p>.</span><span class=t>blob</span><span class=p>());</span>
<span class=p>};</span>

<span class=k>export const </span><span class=t>open </span><span class=p>= </span><span class=k>async </span><span class=p>(</span>
  cropper<span class=p>:</span> Cropper<span class=p>,</span>
  file<span class=p>:</span> File<span class=p>,</span>
  signal<span class=p>:</span> AbortSignal
<span class=p>) =&gt; {</span>
  <span class=k>const</span> image <span class=p>= </span><span class=k>await </span><span class=t>loadImage</span><span class=p>(</span>file<span class=p>, {</span>
    timeout<span class=p>: </span><span class=n>30_000</span><span class=p>,</span>
    decode<span class=p>:</span> convert<span class=p>,</span>
    signal<span class=p>,</span>
  <span class=p>});</span>
  <span class=t>attachImage</span><span class=p>(</span>cropper<span class=p>,</span> image<span class=p>);</span>
<span class=p>};</span>",
