<span class=p>] </span><span class=k>as const</span><span class=p>;</span>

<span class=k>export const </span><span class=t>Ratios </span><span class=p>= () =&gt; {</span>
  <span class=k>const</span> aspect <span class=p>= </span><span class=t>useCropperState</span><span class=p>((</span>s<span class=p>) =&gt;</span> s<span class=p>.</span>aspect<span class=p>);</span>
  <span class=k>const</span> wide <span class=p>= </span><span class=k>typeof</span> aspect <span class=p>=== </span><span class=s>"number" </span><span class=p>&amp;&amp;</span> aspect <span class=p>&gt; </span><span class=n>1</span><span class=p>;</span>
  <span class=k>return </span><span class=p>(</span>
    <span class=p>&lt;</span><span class=t>Cropper.AspectGroup </span><span class=a>aria-label</span><span class=p>="</span><span class=s>Aspect ratio</span><span class=p>"&gt;</span>
      <span class=p>&lt;</span><span class=t>Cropper.AspectItem </span><span class=a>value</span><span class=p>="</span><span class=s>free</span><span class=p>"&gt;</span>free<span class=p>&lt;/</span><span class=t>Cropper.AspectItem</span><span class=p>&gt;</span>
      <span class=p>&lt;</span><span class=t>Cropper.AspectItem </span><span class=a>value</span><span class=p>={</span><span class=n>1</span><span class=p>}&gt;</span>1:1<span class=p>&lt;/</span><span class=t>Cropper.AspectItem</span><span class=p>&gt;</span>
