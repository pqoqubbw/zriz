    "aspect-ratio/ratios.tsx",
    ""use client";

import { useCropperState } from "@zriz/react";
import * as Cropper from "@zriz/react/cropper";

const RATIOS = [
  [4, 5],
  [3, 4],
  [9, 16],
] as const;

export const Ratios = () => {
  const aspect = useCropperState((s) => s.aspect);
  const wide = typeof aspect === "number" && aspect > 1;

  return (
    <Cropper.AspectGroup aria-label="Aspect ratio">
      <Cropper.AspectItem value="free">free</Cropper.AspectItem>
      <Cropper.AspectItem value={1}>1:1</Cropper.AspectItem>
      {RATIOS.map(([w, h]) => (
        <Cropper.AspectItem
          key={\`\${w}:\${h}\`}
          value={wide ? h / w : w / h}
        >
          {wide ? \`\${h}:\${w}\` : \`\${w}:\${h}\`}
        </Cropper.AspectItem>
      ))}
    </Cropper.AspectGroup>
  );
};",
    "<span class=s>"use client"</span><span class=p>;</span>

<span class=k>import </span><span class=p>{</span> useCropperState <span class=p>} </span><span class=k>from </span><span class=s>"@zriz/react"</span><span class=p>;</span>
<span class=k>import </span><span class=p>* </span><span class=k>as</span> Cropper <span class=k>from </span><span class=s>"@zriz/react/cropper"</span><span class=p>;</span>

<span class=k>const</span> RATIOS <span class=p>= [</span>
  <span class=p>[</span><span class=n>4</span><span class=p>, </span><span class=n>5</span><span class=p>],</span>
  <span class=p>[</span><span class=n>3</span><span class=p>, </span><span class=n>4</span><span class=p>],</span>
  <span class=p>[</span><span class=n>9</span><span class=p>, </span><span class=n>16</span><span class=p>],</span>
<span class=p>] </span><span class=k>as const</span><span class=p>;</span>

<span class=k>export const </span><span class=t>Ratios </span><span class=p>= () =&gt; {</span>
  <span class=k>const</span> aspect <span class=p>= </span><span class=t>useCropperState</span><span class=p>((</span>s<span class=p>) =&gt;</span> s<span class=p>.</span>aspect<span class=p>);</span>
  <span class=k>const</span> wide <span class=p>= </span><span class=k>typeof</span> aspect <span class=p>=== </span><span class=s>"number" </span><span class=p>&amp;&amp;</span> aspect <span class=p>&gt; </span><span class=n>1</span><span class=p>;</span>

  <span class=k>return </span><span class=p>(</span>
    <span class=p>&lt;</span><span class=t>Cropper.AspectGroup </span><span class=a>aria-label</span><span class=p>="</span><span class=s>Aspect ratio</span><span class=p>"&gt;</span>
      <span class=p>&lt;</span><span class=t>Cropper.AspectItem </span><span class=a>value</span><span class=p>="</span><span class=s>free</span><span class=p>"&gt;</span>free<span class=p>&lt;/</span><span class=t>Cropper.AspectItem</span><span class=p>&gt;</span>
      <span class=p>&lt;</span><span class=t>Cropper.AspectItem </span><span class=a>value</span><span class=p>={</span><span class=n>1</span><span class=p>}&gt;</span>1:1<span class=p>&lt;/</span><span class=t>Cropper.AspectItem</span><span class=p>&gt;</span>
      <span class=p>{</span>RATIOS<span class=p>.</span><span class=t>map</span><span class=p>(([</span>w<span class=p>,</span> h<span class=p>]) =&gt; (</span>
        <span class=p>&lt;</span><span class=t>Cropper.AspectItem</span>
          <span class=a>key</span><span class=p>={</span><span class=s>\`</span><span class=p>\${</span>w<span class=p>}</span><span class=s>:</span><span class=p>\${</span>h<span class=p>}</span><span class=s>\`</span><span class=p>}</span>
          <span class=a>value</span><span class=p>={</span>wide <span class=p>?</span> h <span class=p>/</span> w <span class=p>:</span> w <span class=p>/</span> h<span class=p>}</span>
        <span class=p>&gt;</span>
          <span class=p>{</span>wide <span class=p>? </span><span class=s>\`</span><span class=p>\${</span>h<span class=p>}</span><span class=s>:</span><span class=p>\${</span>w<span class=p>}</span><span class=s>\` </span><span class=p>: </span><span class=s>\`</span><span class=p>\${</span>w<span class=p>}</span><span class=s>:</span><span class=p>\${</span>h<span class=p>}</span><span class=s>\`</span><span class=p>}</span>
        <span class=p>&lt;/</span><span class=t>Cropper.AspectItem</span><span class=p>&gt;</span>
