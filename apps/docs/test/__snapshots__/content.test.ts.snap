<span class=k>if </span><span class=p>(</span>shown <span class=p>!==</span> src<span class=p>) {</span>
  <span class=t>setShown</span><span class=p>(</span>src<span class=p>);</span>
  <span class=t>setReady</span><span class=p>(</span><span class=n>false</span><span class=p>);</span>
  <span class=t>setFailed</span><span class=p>(</span><span class=n>false</span><span class=p>);</span>
  <span class=t>setExportFailed</span><span class=p>(</span><span class=n>false</span><span class=p>);</span>
<span class=p>}</span>

