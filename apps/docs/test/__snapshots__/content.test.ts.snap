    "accessibility",
    "accessibility/no-drag.tsx",
    ""use client";

import { attachImage } from "@zriz/core/dom";
import { useCropper } from "@zriz/react";
import * as Cropper from "@zriz/react/cropper";
import { useEffect } from "react";

export const Editor = ({ src }: { src: string }) => {
  const cropper = useCropper();

  useEffect(() => () => attachImage(cropper, null), [cropper]);

  const turn = (by: number) => {
    cropper.setRotation(cropper.getValue().rotation + by, {
      reason: "keyboard",
    });
  };

  const move = (x: number, y: number) => {
    cropper.panBy(x, y, { reason: "keyboard" });
  };

  const resize = (by: number) => {
    const state = cropper.getCropState();

    if (state) {
      const crop = {
        ...state.crop,
        height: state.crop.height * by,
        width: state.crop.width * by,
      };

      cropper.setCropState(
        { ...state, crop },
        { keep: "center", reason: "keyboard" }
      );
    }
  };

  return (
    <>
      <Cropper.Root cropper={cropper} src={src}>
        <Cropper.Viewport
          style={{ maxWidth: 480, height: 360 }}
        >
          <Cropper.Image />
          <Cropper.Mask />
          <Cropper.Area aria-label="Crop area" />
        </Cropper.Viewport>
      </Cropper.Root>
      <button onClick={() => turn(-1)}>straighten left</button>
      <button onClick={() => turn(1)}>straighten right</button>
      <button onClick={() => move(-0.01, 0)}>move left</button>
      <button onClick={() => move(0.01, 0)}>move right</button>
      <button onClick={() => move(0, -0.01)}>move up</button>
      <button onClick={() => move(0, 0.01)}>move down</button>
      <button onClick={() => resize(0.9)}>smaller crop</button>
      <button onClick={() => resize(1.1)}>larger crop</button>
    </>
  );
};",
    "<span class=s>"use client"</span><span class=p>;</span>

<span class=k>import </span><span class=p>{</span> attachImage <span class=p>} </span><span class=k>from </span><span class=s>"@zriz/core/dom"</span><span class=p>;</span>
<span class=k>import </span><span class=p>{</span> useCropper <span class=p>} </span><span class=k>from </span><span class=s>"@zriz/react"</span><span class=p>;</span>
<span class=k>import </span><span class=p>* </span><span class=k>as</span> Cropper <span class=k>from </span><span class=s>"@zriz/react/cropper"</span><span class=p>;</span>
<span class=k>import </span><span class=p>{</span> useEffect <span class=p>} </span><span class=k>from </span><span class=s>"react"</span><span class=p>;</span>

<span class=k>export const </span><span class=t>Editor </span><span class=p>= ({</span> src <span class=p>}: {</span> src<span class=p>:</span> string <span class=p>}) =&gt; {</span>
  <span class=k>const</span> cropper <span class=p>= </span><span class=t>useCropper</span><span class=p>();</span>

  <span class=t>useEffect</span><span class=p>(() =&gt; () =&gt; </span><span class=t>attachImage</span><span class=p>(</span>cropper<span class=p>, </span><span class=k>null</span><span class=p>), [</span>cropper<span class=p>]);</span>

  <span class=k>const </span><span class=t>turn </span><span class=p>= (</span>by<span class=p>:</span> number<span class=p>) =&gt; {</span>
    cropper<span class=p>.</span><span class=t>setRotation</span><span class=p>(</span>cropper<span class=p>.</span><span class=t>getValue</span><span class=p>().</span>rotation <span class=p>+</span> by<span class=p>, {</span>
