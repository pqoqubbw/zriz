        width<span class=p>:</span> state<span class=p>.</span>crop<span class=p>.</span>width <span class=p>*</span> by<span class=p>,</span>
      <span class=p>};</span>
      cropper<span class=p>.</span><span class=t>setCropState</span><span class=p>(</span>
        <span class=p>{ ...</span>state<span class=p>,</span> crop <span class=p>},</span>
        <span class=p>{</span> keep<span class=p>: </span><span class=s>"centre"</span><span class=p>,</span> reason<span class=p>: </span><span class=s>"keyboard" </span><span class=p>}</span>
      <span class=p>);</span>
    <span class=p>}</span>
  <span class=p>};</span>
  <span class=k>return </span><span class=p>(</span>
    <span class=p>&lt;&gt;</span>
