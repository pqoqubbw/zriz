        <span class=p>&lt;</span><span class=t>Cropper.Viewport</span>
          <span class=a>style</span><span class=p>={{</span> maxWidth<span class=p>: </span><span class=n>480</span><span class=p>,</span> height<span class=p>: </span><span class=n>360 </span><span class=p>}}</span>
        <span class=p>&gt;</span>
          <span class=p>&lt;</span><span class=t>Cropper.Image </span><span class=p>/&gt;</span>
          <span class=p>&lt;</span><span class=t>Cropper.Mask </span><span class=p>/&gt;</span>
          <span class=p>&lt;</span><span class=t>Cropper.Area </span><span class=a>aria-label</span><span class=p>="</span><span class=s>Crop area</span><span class=p>" /&gt;</span>
        <span class=p>&lt;/</span><span class=t>Cropper.Viewport</span><span class=p>&gt;</span>
      <span class=p>&lt;/</span><span class=t>Cropper.Root</span><span class=p>&gt;</span>
      <span class=p>&lt;</span><span class=t>button </span><span class=a>onClick</span><span class=p>={() =&gt; </span><span class=t>turn</span><span class=p>(-</span><span class=n>1</span><span class=p>)}&gt;</span>straighten left<span class=p>&lt;/</span><span class=t>button</span><span class=p>&gt;</span>
      <span class=p>&lt;</span><span class=t>button </span><span class=a>onClick</span><span class=p>={() =&gt; </span><span class=t>turn</span><span class=p>(</span><span class=n>1</span><span class=p>)}&gt;</span>straighten right<span class=p>&lt;/</span><span class=t>button</span><span class=p>&gt;</span>
      <span class=p>&lt;</span><span class=t>button </span><span class=a>onClick</span><span class=p>={() =&gt; </span><span class=t>move</span><span class=p>(-</span><span class=n>0.01</span><span class=p>, </span><span class=n>0</span><span class=p>)}&gt;</span>move left<span class=p>&lt;/</span><span class=t>button</span><span class=p>&gt;</span>
      <span class=p>&lt;</span><span class=t>button </span><span class=a>onClick</span><span class=p>={() =&gt; </span><span class=t>move</span><span class=p>(</span><span class=n>0.01</span><span class=p>, </span><span class=n>0</span><span class=p>)}&gt;</span>move right<span class=p>&lt;/</span><span class=t>button</span><span class=p>&gt;</span>
      <span class=p>&lt;</span><span class=t>button </span><span class=a>onClick</span><span class=p>={() =&gt; </span><span class=t>move</span><span class=p>(</span><span class=n>0</span><span class=p>, -</span><span class=n>0.01</span><span class=p>)}&gt;</span>move up<span class=p>&lt;/</span><span class=t>button</span><span class=p>&gt;</span>
      <span class=p>&lt;</span><span class=t>button </span><span class=a>onClick</span><span class=p>={() =&gt; </span><span class=t>move</span><span class=p>(</span><span class=n>0</span><span class=p>, </span><span class=n>0.01</span><span class=p>)}&gt;</span>move down<span class=p>&lt;/</span><span class=t>button</span><span class=p>&gt;</span>
      <span class=p>&lt;</span><span class=t>button </span><span class=a>onClick</span><span class=p>={() =&gt; </span><span class=t>resize</span><span class=p>(</span><span class=n>0.9</span><span class=p>)}&gt;</span>smaller crop<span class=p>&lt;/</span><span class=t>button</span><span class=p>&gt;</span>
      <span class=p>&lt;</span><span class=t>button </span><span class=a>onClick</span><span class=p>={() =&gt; </span><span class=t>resize</span><span class=p>(</span><span class=n>1.1</span><span class=p>)}&gt;</span>larger crop<span class=p>&lt;/</span><span class=t>button</span><span class=p>&gt;</span>
