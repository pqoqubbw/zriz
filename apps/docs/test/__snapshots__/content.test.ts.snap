    "server-crop",
    "server-crop/crop-upload.tsx",
    "const unreadable =
  "this photo does not open. pick a jpeg, png, webp or avif.";

const [picks, setPicks] = useState(0);

const last = useRef<AbortController | null>(null);

useEffect(() => () => last.current?.abort(), []);

useEffect(
  () => () => {
    if (result) URL.revokeObjectURL(result);
  },
  [result]
);

const upload = async () => {
  const value = actions.current?.getValue();

  if (!file || !value) return;
  last.current?.abort();
  const controller = new AbortController();
  const { signal } = controller;

  last.current = controller;
  setError(null);
  setResult(null);
  const form = new FormData();

  form.append("file", file);
  form.append("value", serialize(value));

  try {
    const response = await fetch("/api/crop", {
      method: "POST",
      body: form,
      signal,
    });

    if (response.ok) {
      const blob = await response.blob();

      if (!signal.aborted) {
        setResult(URL.createObjectURL(blob));
      }
    } else {
      const message = await response.text();

      if (!signal.aborted) setError(message);
    }
  } catch {
    if (!signal.aborted) {
      setError("the upload did not reach the server.");
    }
  }
};

<input
  aria-label="Choose a photo"
  type="file"
  accept="image/jpeg,image/png,image/webp,image/avif"
  onClick={(event) => {
    event.currentTarget.value = "";
  }}
  onChange={(event) => {
    last.current?.abort();
    setReady(false);
    setError(null);
    setResult(null);
    setPicks((count) => count + 1);
    setFile(event.target.files?.[0] ?? null);
  }}
/>

<Cropper.Root
  key={picks}
  actionsRef={actions}
  maxZoom={MAX_ZOOM}
  minSize={MIN_SIZE}
  src={file}
  svg={false}
  onLoad={() => setReady(true)}
  onError={() => setError(unreadable)}
>

<button type="button" disabled={!ready} onClick={upload}>
  upload
</button>",
    "<span class=k>const</span> unreadable <span class=p>=</span>
  <span class=s>"this photo does not open. pick a jpeg, png, webp or avif."</span><span class=p>;</span>

<span class=k>const </span><span class=p>[</span>picks<span class=p>,</span> setPicks<span class=p>] = </span><span class=t>useState</span><span class=p>(</span><span class=n>0</span><span class=p>);</span>

<span class=k>const</span> last <span class=p>= </span><span class=t>useRef</span><span class=p>&lt;</span>AbortController <span class=p>|</span> null<span class=p>&gt;(</span><span class=k>null</span><span class=p>);</span>

<span class=t>useEffect</span><span class=p>(() =&gt; () =&gt;</span> last<span class=p>.</span>current<span class=p>?.</span><span class=t>abort</span><span class=p>(), []);</span>

<span class=t>useEffect</span><span class=p>(</span>
  <span class=p>() =&gt; () =&gt; {</span>
    <span class=k>if </span><span class=p>(</span>result<span class=p>)</span> URL<span class=p>.</span><span class=t>revokeObjectURL</span><span class=p>(</span>result<span class=p>);</span>
  <span class=p>},</span>
  <span class=p>[</span>result<span class=p>]</span>
<span class=p>);</span>

<span class=k>const </span><span class=t>upload </span><span class=p>= </span><span class=k>async </span><span class=p>() =&gt; {</span>
  <span class=k>const</span> value <span class=p>=</span> actions<span class=p>.</span>current<span class=p>?.</span><span class=t>getValue</span><span class=p>();</span>

  <span class=k>if </span><span class=p>(!</span>file <span class=p>|| !</span>value<span class=p>) </span><span class=k>return</span><span class=p>;</span>
  last<span class=p>.</span>current<span class=p>?.</span><span class=t>abort</span><span class=p>();</span>
  <span class=k>const</span> controller <span class=p>= </span><span class=k>new </span><span class=t>AbortController</span><span class=p>();</span>
  <span class=k>const </span><span class=p>{</span> signal <span class=p>} =</span> controller<span class=p>;</span>

  last<span class=p>.</span>current <span class=p>=</span> controller<span class=p>;</span>
  <span class=t>setError</span><span class=p>(</span><span class=k>null</span><span class=p>);</span>
  <span class=t>setResult</span><span class=p>(</span><span class=k>null</span><span class=p>);</span>
  <span class=k>const</span> form <span class=p>= </span><span class=k>new </span><span class=t>FormData</span><span class=p>();</span>

  form<span class=p>.</span><span class=t>append</span><span class=p>(</span><span class=s>"file"</span><span class=p>,</span> file<span class=p>);</span>
  form<span class=p>.</span><span class=t>append</span><span class=p>(</span><span class=s>"value"</span><span class=p>, </span><span class=t>serialize</span><span class=p>(</span>value<span class=p>));</span>

  <span class=k>try </span><span class=p>{</span>
    <span class=k>const</span> response <span class=p>= </span><span class=k>await </span><span class=t>fetch</span><span class=p>(</span><span class=s>"/api/crop"</span><span class=p>, {</span>
      method<span class=p>: </span><span class=s>"POST"</span><span class=p>,</span>
      body<span class=p>:</span> form<span class=p>,</span>
      signal<span class=p>,</span>
    <span class=p>});</span>

    <span class=k>if </span><span class=p>(</span>response<span class=p>.</span>ok<span class=p>) {</span>
      <span class=k>const</span> blob <span class=p>= </span><span class=k>await</span> response<span class=p>.</span><span class=t>blob</span><span class=p>();</span>

      <span class=k>if </span><span class=p>(!</span>signal<span class=p>.</span>aborted<span class=p>) {</span>
        <span class=t>setResult</span><span class=p>(</span>URL<span class=p>.</span><span class=t>createObjectURL</span><span class=p>(</span>blob<span class=p>));</span>
      <span class=p>}</span>
    <span class=p>} </span><span class=k>else </span><span class=p>{</span>
      <span class=k>const</span> message <span class=p>= </span><span class=k>await</span> response<span class=p>.</span><span class=t>text</span><span class=p>();</span>

      <span class=k>if </span><span class=p>(!</span>signal<span class=p>.</span>aborted<span class=p>) </span><span class=t>setError</span><span class=p>(</span>message<span class=p>);</span>
    <span class=p>}</span>
  <span class=p>} </span><span class=k>catch </span><span class=p>{</span>
    <span class=k>if </span><span class=p>(!</span>signal<span class=p>.</span>aborted<span class=p>) {</span>
      <span class=t>setError</span><span class=p>(</span><span class=s>"the upload did not reach the server."</span><span class=p>);</span>
    <span class=p>}</span>
  <span class=p>}</span>
<span class=p>};</span>

<span class=p>&lt;</span><span class=t>input</span>
  <span class=a>aria-label</span><span class=p>="</span><span class=s>Choose a photo</span><span class=p>"</span>
  <span class=a>type</span><span class=p>="</span><span class=s>file</span><span class=p>"</span>
  <span class=a>accept</span><span class=p>="</span><span class=s>image/jpeg,image/png,image/webp,image/avif</span><span class=p>"</span>
  <span class=a>onClick</span><span class=p>={(</span>event<span class=p>) =&gt; {</span>
    event<span class=p>.</span>currentTarget<span class=p>.</span>value <span class=p>= </span><span class=s>""</span><span class=p>;</span>
  <span class=p>}}</span>
  <span class=a>onChange</span><span class=p>={(</span>event<span class=p>) =&gt; {</span>
    last<span class=p>.</span>current<span class=p>?.</span><span class=t>abort</span><span class=p>();</span>
    <span class=t>setReady</span><span class=p>(</span><span class=n>false</span><span class=p>);</span>
    <span class=t>setError</span><span class=p>(</span><span class=k>null</span><span class=p>);</span>
    <span class=t>setResult</span><span class=p>(</span><span class=k>null</span><span class=p>);</span>
    <span class=t>setPicks</span><span class=p>((</span>count<span class=p>) =&gt;</span> count <span class=p>+ </span><span class=n>1</span><span class=p>);</span>
    <span class=t>setFile</span><span class=p>(</span>event<span class=p>.</span>target<span class=p>.</span>files<span class=p>?.[</span><span class=n>0</span><span class=p>] ?? </span><span class=k>null</span><span class=p>);</span>
  <span class=p>}}</span>
<span class=p>/&gt;</span>

<span class=p>&lt;</span><span class=t>Cropper.Root</span>
  <span class=a>key</span><span class=p>={</span>picks<span class=p>}</span>
  <span class=a>actionsRef</span><span class=p>={</span>actions<span class=p>}</span>
  <span class=a>maxZoom</span><span class=p>={</span>MAX_ZOOM<span class=p>}</span>
  <span class=a>minSize</span><span class=p>={</span>MIN_SIZE<span class=p>}</span>
  <span class=a>src</span><span class=p>={</span>file<span class=p>}</span>
