<span class=k>import </span><span class=p>{</span> useEffect<span class=p>,</span> useRef<span class=p>,</span> useState <span class=p>} </span><span class=k>from </span><span class=s>"react"</span><span class=p>;</span>
<span class=k>import </span><span class=p>{</span> MAX_ZOOM<span class=p>,</span> MIN_SIZE <span class=p>} </span><span class=k>from </span><span class=s>"./crop-limits"</span><span class=p>;</span>

<span class=k>const</span> unreadable <span class=p>=</span>
  <span class=s>"this photo does not open. pick a jpeg, png, webp or avif."</span><span class=p>;</span>

<span class=k>export const </span><span class=t>CropUpload </span><span class=p>= () =&gt; {</span>
  <span class=k>const </span><span class=p>[</span>file<span class=p>,</span> setFile<span class=p>] = </span><span class=t>useState</span><span class=p>&lt;</span>File <span class=p>|</span> null<span class=p>&gt;(</span><span class=k>null</span><span class=p>);</span>
  <span class=k>const </span><span class=p>[</span>ready<span class=p>,</span> setReady<span class=p>] = </span><span class=t>useState</span><span class=p>(</span><span class=n>false</span><span class=p>);</span>
  <span class=k>const </span><span class=p>[</span>result<span class=p>,</span> setResult<span class=p>] = </span><span class=t>useState</span><span class=p>&lt;</span>string <span class=p>|</span> null<span class=p>&gt;(</span><span class=k>null</span><span class=p>);</span>
  <span class=k>const </span><span class=p>[</span>error<span class=p>,</span> setError<span class=p>] = </span><span class=t>useState</span><span class=p>&lt;</span>string <span class=p>|</span> null<span class=p>&gt;(</span><span class=k>null</span><span class=p>);</span>
  <span class=k>const </span><span class=p>[</span>picks<span class=p>,</span> setPicks<span class=p>] = </span><span class=t>useState</span><span class=p>(</span><span class=n>0</span><span class=p>);</span>
  <span class=k>const</span> actions <span class=p>= </span><span class=t>useRef</span><span class=p>&lt;</span>CropperApi<span class=p>&gt;(</span><span class=k>null</span><span class=p>);</span>
  <span class=k>const</span> last <span class=p>= </span><span class=t>useRef</span><span class=p>&lt;</span>AbortController <span class=p>|</span> null<span class=p>&gt;(</span><span class=k>null</span><span class=p>);</span>

  <span class=t>useEffect</span><span class=p>(() =&gt; () =&gt;</span> last<span class=p>.</span>current<span class=p>?.</span><span class=t>abort</span><span class=p>(), []);</span>

