    <span class=p>&lt;</span><span class=t>Cropper.Area </span><span class=a>aria-label</span><span class=p>="</span><span class=s>Crop area</span><span class=p>" /&gt;</span>
  <span class=p>&lt;/</span><span class=t>Cropper.Viewport</span><span class=p>&gt;</span>
<span class=p>&lt;/</span><span class=t>Cropper.Root</span><span class=p>&gt;</span>",
