  <span class=a>onValueCommit</span><span class=p>={(</span>value<span class=p>,</span> details<span class=p>) =&gt; {</span>
    <span class=k>if </span><span class=p>(</span>details<span class=p>.</span>reason <span class=p>=== </span><span class=s>"coverage"</span><span class=p>) </span><span class=k>return</span><span class=p>;</span>

    <span class=k>try </span><span class=p>{</span>
