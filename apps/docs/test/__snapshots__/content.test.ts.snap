    "exporting",
    "exporting/save-crop.tsx",
    ""use client";

import { exportCrop } from "@zriz/core/dom";
import type { Cropper as CropperApi } from "@zriz/react";
import * as Cropper from "@zriz/react/cropper";
import { useEffect, useRef, useState } from "react";

export const SaveCrop = ({ file }: { file: File }) => {
  const cropper = useRef<CropperApi>(null);
  const running = useRef<AbortController | null>(null);
  const [loaded, setLoaded] = useState<File | null>(null);
  const [saving, setSaving] = useState(false);

  useEffect(() => () => running.current?.abort(), [file]);

  const save = async () => {
    if (!cropper.current || running.current) return;
    const controller = new AbortController();

    running.current = controller;
    setSaving(true);
    const result = await exportCrop(cropper.current, {
      type: "image/webp",
      maxSize: { width: 2048, height: 2048 },
      signal: controller.signal,
    }).catch((error: unknown) => {
      if (!controller.signal.aborted) console.error(error);

      return null;
    });

    running.current = null;
    setSaving(false);
    if (!result) return;
    const { blob, type } = result;
    const link = document.createElement("a");

    link.href = URL.createObjectURL(blob);
    const extension = type === "image/webp" ? "webp" : "png";

    link.download = \`crop.\${extension}\`;
    link.click();
    setTimeout(() => URL.revokeObjectURL(link.href), 1000);
  };

  return (
    <>
      <Cropper.Root
        src={file}
        actionsRef={cropper}
        onLoad={() => setLoaded(file)}
      >
        <Cropper.Viewport style={{ width: 480, height: 360 }}>
          <Cropper.Image />
          <Cropper.Mask />
          <Cropper.Area aria-label="Crop area" />
        </Cropper.Viewport>
      </Cropper.Root>
      <button
        type="button"
        disabled={loaded !== file}
        aria-disabled={saving}
        onClick={save}
      >
        save
      </button>
    </>
  );
};",
    "<span class=s>"use client"</span><span class=p>;</span>

<span class=k>import </span><span class=p>{</span> exportCrop <span class=p>} </span><span class=k>from </span><span class=s>"@zriz/core/dom"</span><span class=p>;</span>
<span class=k>import type </span><span class=p>{</span> Cropper <span class=k>as</span> CropperApi <span class=p>} </span><span class=k>from </span><span class=s>"@zriz/react"</span><span class=p>;</span>
<span class=k>import </span><span class=p>* </span><span class=k>as</span> Cropper <span class=k>from </span><span class=s>"@zriz/react/cropper"</span><span class=p>;</span>
<span class=k>import </span><span class=p>{</span> useEffect<span class=p>,</span> useRef<span class=p>,</span> useState <span class=p>} </span><span class=k>from </span><span class=s>"react"</span><span class=p>;</span>

<span class=k>export const </span><span class=t>SaveCrop </span><span class=p>= ({</span> file <span class=p>}: {</span> file<span class=p>:</span> File <span class=p>}) =&gt; {</span>
  <span class=k>const</span> cropper <span class=p>= </span><span class=t>useRef</span><span class=p>&lt;</span>CropperApi<span class=p>&gt;(</span><span class=k>null</span><span class=p>);</span>
  <span class=k>const</span> running <span class=p>= </span><span class=t>useRef</span><span class=p>&lt;</span>AbortController <span class=p>|</span> null<span class=p>&gt;(</span><span class=k>null</span><span class=p>);</span>
  <span class=k>const </span><span class=p>[</span>loaded<span class=p>,</span> setLoaded<span class=p>] = </span><span class=t>useState</span><span class=p>&lt;</span>File <span class=p>|</span> null<span class=p>&gt;(</span><span class=k>null</span><span class=p>);</span>
  <span class=k>const </span><span class=p>[</span>saving<span class=p>,</span> setSaving<span class=p>] = </span><span class=t>useState</span><span class=p>(</span><span class=n>false</span><span class=p>);</span>

  <span class=t>useEffect</span><span class=p>(() =&gt; () =&gt;</span> running<span class=p>.</span>current<span class=p>?.</span><span class=t>abort</span><span class=p>(), [</span>file<span class=p>]);</span>

  <span class=k>const </span><span class=t>save </span><span class=p>= </span><span class=k>async </span><span class=p>() =&gt; {</span>
    <span class=k>if </span><span class=p>(!</span>cropper<span class=p>.</span>current <span class=p>||</span> running<span class=p>.</span>current<span class=p>) </span><span class=k>return</span><span class=p>;</span>
    <span class=k>const</span> controller <span class=p>= </span><span class=k>new </span><span class=t>AbortController</span><span class=p>();</span>

    running<span class=p>.</span>current <span class=p>=</span> controller<span class=p>;</span>
    <span class=t>setSaving</span><span class=p>(</span><span class=n>true</span><span class=p>);</span>
    <span class=k>const</span> result <span class=p>= </span><span class=k>await </span><span class=t>exportCrop</span><span class=p>(</span>cropper<span class=p>.</span>current<span class=p>, {</span>
      type<span class=p>: </span><span class=s>"image/webp"</span><span class=p>,</span>
      maxSize<span class=p>: {</span> width<span class=p>: </span><span class=n>2048</span><span class=p>,</span> height<span class=p>: </span><span class=n>2048 </span><span class=p>},</span>
      signal<span class=p>:</span> controller<span class=p>.</span>signal<span class=p>,</span>
    <span class=p>}).</span><span class=t>catch</span><span class=p>((</span>error<span class=p>:</span> unknown<span class=p>) =&gt; {</span>
      <span class=k>if </span><span class=p>(!</span>controller<span class=p>.</span>signal<span class=p>.</span>aborted<span class=p>)</span> console<span class=p>.</span><span class=t>error</span><span class=p>(</span>error<span class=p>);</span>

      <span class=k>return null</span><span class=p>;</span>
    <span class=p>});</span>

    running<span class=p>.</span>current <span class=p>= </span><span class=k>null</span><span class=p>;</span>
    <span class=t>setSaving</span><span class=p>(</span><span class=n>false</span><span class=p>);</span>
    <span class=k>if </span><span class=p>(!</span>result<span class=p>) </span><span class=k>return</span><span class=p>;</span>
    <span class=k>const </span><span class=p>{</span> blob<span class=p>,</span> type <span class=p>} =</span> result<span class=p>;</span>
    <span class=k>const</span> link <span class=p>=</span> document<span class=p>.</span><span class=t>createElement</span><span class=p>(</span><span class=s>"a"</span><span class=p>);</span>

    link<span class=p>.</span>href <span class=p>=</span> URL<span class=p>.</span><span class=t>createObjectURL</span><span class=p>(</span>blob<span class=p>);</span>
    <span class=k>const</span> extension <span class=p>=</span> type <span class=p>=== </span><span class=s>"image/webp" </span><span class=p>? </span><span class=s>"webp" </span><span class=p>: </span><span class=s>"png"</span><span class=p>;</span>

    link<span class=p>.</span>download <span class=p>= </span><span class=s>\`crop.</span><span class=p>\${</span>extension<span class=p>}</span><span class=s>\`</span><span class=p>;</span>
    link<span class=p>.</span><span class=t>click</span><span class=p>();</span>
    <span class=t>setTimeout</span><span class=p>(() =&gt;</span> URL<span class=p>.</span><span class=t>revokeObjectURL</span><span class=p>(</span>link<span class=p>.</span>href<span class=p>), </span><span class=n>1000</span><span class=p>);</span>
  <span class=p>};</span>

  <span class=k>return </span><span class=p>(</span>
    <span class=p>&lt;&gt;</span>
      <span class=p>&lt;</span><span class=t>Cropper.Root</span>
        <span class=a>src</span><span class=p>={</span>file<span class=p>}</span>
        <span class=a>actionsRef</span><span class=p>={</span>cropper<span class=p>}</span>
        <span class=a>onLoad</span><span class=p>={() =&gt; </span><span class=t>setLoaded</span><span class=p>(</span>file<span class=p>)}</span>
      <span class=p>&gt;</span>
        <span class=p>&lt;</span><span class=t>Cropper.Viewport </span><span class=a>style</span><span class=p>={{</span> width<span class=p>: </span><span class=n>480</span><span class=p>,</span> height<span class=p>: </span><span class=n>360 </span><span class=p>}}&gt;</span>
          <span class=p>&lt;</span><span class=t>Cropper.Image </span><span class=p>/&gt;</span>
          <span class=p>&lt;</span><span class=t>Cropper.Mask </span><span class=p>/&gt;</span>
          <span class=p>&lt;</span><span class=t>Cropper.Area </span><span class=a>aria-label</span><span class=p>="</span><span class=s>Crop area</span><span class=p>" /&gt;</span>
        <span class=p>&lt;/</span><span class=t>Cropper.Viewport</span><span class=p>&gt;</span>
      <span class=p>&lt;/</span><span class=t>Cropper.Root</span><span class=p>&gt;</span>
