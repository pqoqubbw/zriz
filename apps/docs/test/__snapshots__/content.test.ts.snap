  <span class=p>}, [</span>id<span class=p>,</span> key<span class=p>]);</span>

  <span class=k>if </span><span class=p>(</span>saved<span class=p>?.</span>id <span class=p>!==</span> id<span class=p>) </span><span class=k>return null</span><span class=p>;</span>

  <span class=k>return </span><span class=p>(</span>
    <span class=p>&lt;</span><span class=t>Cropper.Root</span>
      <span class=a>src</span><span class=p>={</span>src<span class=p>}</span>
      <span class=a>defaultValue</span><span class=p>={</span>saved<span class=p>.</span>value <span class=p>?? </span><span class=k>undefined</span><span class=p>}</span>
      <span class=a>onValueCommit</span><span class=p>={(</span>value<span class=p>,</span> details<span class=p>) =&gt; {</span>
        <span class=k>if </span><span class=p>(</span>details<span class=p>.</span>reason <span class=p>=== </span><span class=s>"coverage"</span><span class=p>) </span><span class=k>return</span><span class=p>;</span>

        <span class=k>try </span><span class=p>{</span>
