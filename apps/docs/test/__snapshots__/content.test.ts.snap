        <span class=a>onClick</span><span class=p>={</span>save<span class=p>}</span>
      <span class=p>&gt;</span>
        save
      <span class=p>&lt;/</span><span class=t>button</span><span class=p>&gt;</span>
    <span class=p>&lt;/&gt;</span>
  <span class=p>);</span>
<span class=p>};</span>",
