{
  "name": "zriz",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter docs dev",
    "build": "pnpm --filter \"./packages/*\" build && pnpm --filter docs build",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "check": "ultracite check && oxlint -c apps/docs/lint/snippets.config.ts apps/docs/snippets",
    "fix": "ultracite fix && oxlint -c apps/docs/lint/snippets.config.ts --fix apps/docs/snippets",
    "type": "tsc -p tsconfig.json && pnpm -r type",
    "test": "vitest run",
    "test:unit": "vitest run --project docs --project 'unit*'",
    "test:browser": "vitest run --project 'browser*'",
    "lint:package": "pnpm --filter \"./packages/*\" lint:package",
    "size": "pnpm --filter \"./packages/*\" size",
    "changeset": "changeset",
    "sim": "xcrun simctl openurl booted http://localhost:4777"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "catalog:",
    "axe-core": "^4.14.0",
    "fast-check": "4.10.2",
    "lightningcss": "^1.33.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "ultracite": "8.1.0",
    "vitest": "catalog:",
    "vitest-browser-react": "2.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.34.9",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "packageManager": "pnpm@10.34.9"
}
