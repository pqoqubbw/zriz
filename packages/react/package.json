{
  "name": "@zriz/react",
  "version": "0.0.0",
  "description": "Headless image cropper for React with the feel of iOS Photos: straighten dial, no empty corners.",
  "keywords": [
    "crop",
    "cropper",
    "headless",
    "image",
    "react",
    "rotate",
    "straighten"
  ],
  "homepage": "https://zriz.dev",
  "bugs": "https://github.com/pqoqubbw/zriz/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pqoqubbw/zriz.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.css"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cropper": {
      "types": "./dist/cropper.d.ts",
      "default": "./dist/cropper.js"
    },
    "./warn": {
      "types": "./dist/warn.d.ts",
      "production": "./dist/warn-off.js",
      "default": "./dist/warn.js"
    },
    "./styles.css": {
      "types": "./dist/styles.d.css.ts",
      "default": "./dist/styles.css"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && node ../../scripts/css.ts dist/styles.css && node ../../scripts/maps.ts dist",
    "dev": "tsdown --watch",
    "type": "tsc -p tsconfig.json",
    "lint:package": "publint --strict && attw --pack . --profile esm-only --exclude-entrypoints ./styles.css",
    "size": "size-limit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@size-limit/preset-small-lib": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@zriz/core": "workspace:^",
    "magic-string": "1.4.5",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "size-limit": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@types/react": "^18.2.6 || ^19.0.0",
    "@zriz/core": "workspace:^",
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  }
}
