{
  "name": "@zriz/core",
  "version": "0.0.0",
  "description": "Framework-agnostic core of zriz: crop geometry, coverage solver, springs and export.",
  "keywords": [
    "crop",
    "cropper",
    "headless",
    "image",
    "rotate",
    "straighten"
  ],
  "homepage": "https://zriz.dev",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./geometry": {
      "types": "./dist/geometry/index.d.ts",
      "default": "./dist/geometry/index.js"
    },
    "./dom": {
      "types": "./dist/dom/index.d.ts",
      "default": "./dist/dom/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "type": "tsc -p tsconfig.json",
    "lint:package": "publint --strict && attw --pack . --profile esm-only",
    "size": "size-limit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@size-limit/preset-small-lib": "catalog:",
    "publint": "catalog:",
    "sharp": "0.35.5",
    "size-limit": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "import": "{ coverScale }",
      "limit": "500 B"
    },
    {
      "name": "toSharp",
      "path": "dist/index.js",
      "import": "{ toSharp }",
      "limit": "1 kB"
    },
    {
      "name": "geometry",
      "path": "dist/geometry/index.js",
      "import": "*",
      "limit": "5 kB"
    },
    {
      "name": "createCropper",
      "path": "dist/index.js",
      "import": "{ createCropper }",
      "limit": "5 kB"
    },
    {
      "name": "value",
      "path": "dist/index.js",
      "import": "{ parse, serialize }",
      "limit": "500 B"
    },
    {
      "name": "motion",
      "path": "dist/index.js",
      "import": "{ spring, decay, velocityTracker }",
      "limit": "600 B"
    },
    {
      "name": "dom (all binders)",
      "path": "dist/dom/index.js",
      "import": "*",
      "limit": "10.5 kB"
    },
    {
      "name": "avatar (cropper + viewport + image + mask + area)",
      "path": [
        "dist/index.js",
        "dist/dom/index.js"
      ],
      "import": {
        "dist/index.js": "{ createCropper }",
        "dist/dom/index.js": "{ bindViewport, bindImage, bindMask, bindArea }"
      },
      "limit": "10 kB"
    }
  ]
}
