{
  "name": "@zriz/core",
  "version": "0.0.0",
  "description": "Framework-agnostic core of zriz: crop geometry, coverage solver, springs and export.",
  "keywords": [
    "crop",
    "cropper",
    "headless",
    "image",
    "rotate",
    "straighten"
  ],
  "homepage": "https://zriz.dev",
  "bugs": "https://github.com/pqoqubbw/zriz/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pqoqubbw/zriz.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./geometry": {
      "types": "./dist/geometry/index.d.ts",
      "default": "./dist/geometry/index.js"
    },
    "./dom": {
      "types": "./dist/dom/index.d.ts",
      "default": "./dist/dom/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.d.css.ts",
      "default": "./dist/styles.css"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && node ../../scripts/css.ts dist/styles.css",
    "dev": "tsdown --watch",
    "type": "tsc -p tsconfig.json",
    "lint:package": "publint --strict && attw --pack . --profile esm-only --exclude-entrypoints ./styles.css",
    "size": "size-limit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@size-limit/preset-small-lib": "catalog:",
    "esbuild": "0.28.2",
    "publint": "catalog:",
    "sharp": "0.35.5",
    "size-limit": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "import": "{ coverScale }",
      "limit": "500 B"
    },
    {
      "name": "toSharp",
      "path": "dist/index.js",
      "import": "{ toSharp }",
      "limit": "1 kB"
    },
    {
      "name": "geometry",
      "path": "dist/geometry/index.js",
      "import": "*",
      "limit": "5 kB"
    },
    {
      "name": "createCropper",
      "path": "dist/index.js",
      "import": "{ createCropper }",
      "limit": "6679 B"
    },
    {
      "name": "value",
      "path": "dist/index.js",
      "import": "{ parse, serialize }",
      "limit": "595 B"
    },
    {
      "name": "motion",
      "path": "dist/motion.js",
      "import": "{ spring, decay, velocityTracker }",
      "limit": "600 B"
    },
    {
      "name": "dom (all binders)",
      "path": "dist/dom/index.js",
      "import": "*",
      "limit": "20717 B",
      "entry": [
        "index"
      ]
    },
    {
      "name": "avatar (cropper + viewport + image + mask + area)",
      "path": [
        "dist/index.js",
        "dist/dom/index.js"
      ],
      "import": {
        "dist/index.js": "{ createCropper }",
        "dist/dom/index.js": "{ bindViewport, bindPhoto, bindMask, bindArea, attachImage, loadImage }"
      },
      "limit": "18543 B",
      "entry": [
        "index"
      ]
    },
    {
      "name": "avatar total (with lazy chunks)",
      "path": [
        "dist/index.js",
        "dist/dom/index.js"
      ],
      "import": {
        "dist/index.js": "{ createCropper }",
        "dist/dom/index.js": "{ bindViewport, bindPhoto, bindMask, bindArea, attachImage, loadImage }"
      },
      "limit": "22795 B"
    },
    {
      "name": "image pipeline (loadImage, exportCrop, attachImage)",
      "path": "dist/dom/index.js",
      "import": "{ loadImage, exportCrop, attachImage }",
      "limit": "4164 B",
      "entry": [
        "index"
      ]
    },
    {
      "name": "exportCrop",
      "path": "dist/dom/index.js",
      "import": "{ exportCrop }",
      "limit": "607 B",
      "entry": [
        "index"
      ]
    },
    {
      "name": "exportCrop total (with render chunk)",
      "path": "dist/dom/index.js",
      "import": "{ exportCrop }",
      "limit": "3828 B"
    },
    {
      "name": "loadImage",
      "path": "dist/dom/index.js",
      "import": "{ loadImage }",
      "limit": "3696 B",
      "entry": [
        "index"
      ]
    },
    {
      "name": "lazy chunk dom/render",
      "path": "dist/dom/render.js",
      "import": "*",
      "limit": "3530 B"
    },
    {
      "name": "lazy chunk dom/svg",
      "path": "dist/dom/svg.js",
      "import": "*",
      "limit": "1.34 kB"
    },
    {
      "name": "lazy chunk dom/source",
      "path": "dist/dom/source.js",
      "import": "*",
      "limit": "779 B"
    },
    {
      "name": "lazy chunk dom/sharpen",
      "path": "dist/dom/sharpen.js",
      "import": "*",
      "limit": "2391 B"
    }
  ]
}
